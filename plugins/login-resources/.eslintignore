#
# ESLint ignore rules for the login-resources plugin.
# We specifically exclude SCSS theme files to avoid parser issues
# where ESLint is configured to run against the TypeScript project.
#
# The patterns below are intentionally narrow (plugin src) to avoid
# affecting other packages.
#
# Keep this file minimal — it only contains ignore patterns used by ESLint.

# Ignore SCSS theme files in the plugin source (avoid parser errors)
src/**/*.scss
src/components/themes/*.scss

# Common generated/build folders (matching tsconfig exclude)
node_modules/
lib/
dist/
types/
bundle/
