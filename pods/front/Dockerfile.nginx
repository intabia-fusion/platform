# Nginx + Node hybrid front service
# Nginx serves static files directly on port 8080
# Node handles API endpoints (/config.json, /api/*, /files) on port 3000
# Supervisor manages both processes

FROM nginx:alpine

# Install node.js, supervisor, and build tools for sharp
RUN apk add --no-cache nodejs npm supervisor python3 make g++ vips-dev && \
    mkdir -p /var/log/supervisor

WORKDIR /app

# Build ID for tracking deployments
ARG BUILD_ID=unknown
ENV BUILD_ID=${BUILD_ID}

# Copy static files to nginx html directory
COPY dist/ /usr/share/nginx/html/

# Copy node app
COPY bundle/bundle.js ./
COPY bundle/bundle.js.map ./

# Install sharp for image processing (required by bundle)
RUN npm install sharp node-addon-api node-gyp --omit=dev

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy supervisor configuration
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Expose port
EXPOSE 8080

# Start supervisor (manages both nginx and node)
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
