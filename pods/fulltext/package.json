{
  "name": "@intabiafusion/pod-fulltext",
  "version": "1.0.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "author": "Anticrm Platform Contributors",
  "template": "@intabiafusion/node-package",
  "license": "EPL-2.0",
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "compile",
    "build:watch": "compile",
    "_phase:bundle": "rushx bundle",
    "_phase:docker-build": "rushx docker:build",
    "_phase:docker-staging": "rushx docker:staging",
    "get-model": "node ../../common/scripts/esbuild.js --entry=src/get-model.ts --keep-names=true --bundle=true --define=MODEL_VERSION --define=VERSION --define=GIT_REVISION  && node ./bundle/bundle.js > ./bundle/model.json",
    "bundle": "rushx get-model && node ../../common/scripts/esbuild.js --keep-names=true --bundle=true --external=snappy --sourcemap=external",
    "docker:build": "../../common/scripts/docker_build.sh intabiafusion/fulltext",
    "docker:tbuild": "docker build -t intabiafusion/fulltext . --platform=linux/amd64 && ../../common/scripts/docker_tag_push.sh intabiafusion/fulltext",
    "docker:abuild": "docker build -t intabiafusion/fulltext . --platform=linux/arm64 && ../../common/scripts/docker_tag_push.sh intabiafusion/fulltext",
    "docker:staging": "../../common/scripts/docker_tag.sh intabiafusion/fulltext staging",
    "docker:push": "../../common/scripts/docker_tag.sh intabiafusion/fulltext",
    "format": "format src",
    "test": "jest --passWithNoTests --silent --forceExit",
    "_phase:build": "compile transpile src",
    "_phase:test": "jest --passWithNoTests --silent --forceExit",
    "_phase:format": "format src",
    "_phase:validate": "compile validate"
  },
  "devDependencies": {
    "cross-env": "~7.0.3",
    "@intabiafusion/platform-rig": "workspace:^1.0.0",
    "@types/node": "^22.18.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-n": "^15.4.0",
    "eslint": "^8.54.0",
    "esbuild": "^0.25.10",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint-config-standard-with-typescript": "^40.0.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.5",
    "@intabiafusion/model-all": "workspace:^1.0.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-router": "^7.4.8",
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^5.0.0"
  },
  "dependencies": {
    "@intabiafusion/platform": "workspace:^1.0.0",
    "@intabiafusion/server-token": "workspace:^1.0.0",
    "@intabiafusion/server-core": "workspace:^1.0.0",
    "@intabiafusion/server-pipeline": "workspace:^1.0.0",
    "@intabiafusion/client": "workspace:^1.0.0",
    "@intabiafusion/client-resources": "workspace:^1.0.0",
    "@intabiafusion/core": "workspace:^1.0.0",
    "dotenv": "^16.4.5",
    "@intabiafusion/analytics": "workspace:^1.0.0",
    "@intabiafusion/analytics-service": "workspace:^1.0.0",
    "koa": "^2.15.4",
    "koa-router": "^12.0.1",
    "koa-bodyparser": "^4.4.1",
    "@koa/cors": "^5.0.0",
    "@intabiafusion/server-indexer": "workspace:^1.0.0",
    "@intabiafusion/elastic": "workspace:^1.0.0",
    "@intabiafusion/server-collaboration": "workspace:^1.0.0",
    "@intabiafusion/middleware": "workspace:^1.0.0",
    "@intabiafusion/server-client": "workspace:^1.0.0",
    "@intabiafusion/server-storage": "workspace:^1.0.0",
    "@intabiafusion/postgres": "workspace:^1.0.0",
    "@intabiafusion/mongo": "workspace:^1.0.0",
    "@intabiafusion/kafka": "workspace:^1.0.0",
    "@intabiafusion/communication-server": "workspace:^1.0.0",
    "@intabiafusion/communication-sdk-types": "workspace:^1.0.0",
    "@intabiafusion/hulylake-client": "workspace:^1.0.0"
  }
}
