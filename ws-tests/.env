STORAGE_CONFIG="datalake|http://datalake:4031"
BACKUP_STORAGE_CONFIG="minio|minio?accessKey=minioadmin&secretKey=minioadmin"
BACKUP_BUCKET_NAME=ws-dev-backups
# America region - CockroachDB
DB_URL=postgresql://root@cockroach:26257/defaultdb?sslmode=disable
# Europe region - pure PostgreSQL
DB_EU_URL=postgres://postgres:postgres@postgres:5433/postgres
# Used by services (activity, notifications) which share pure PG
DB_PG_URL=postgres://postgres:postgres@postgres:5433/postgres
QUEUE_CONFIG=redpanda:9093
