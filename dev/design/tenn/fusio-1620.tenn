        }
        item Note { title "Это не счёт, поддержка по желанию"; font-size 11; line-height 15; text-color #7f7f7f; layout left }
      }
    }
  }
}

element "9 Панель поддержки" {
  item Screen {
    auto-layout abs; width 1920; height 1080; clip yes; color #ffffff
    use Libraries.workbench.Workbench as Workbench {
      pos -0 -1
      slot Main_panel {
        item Workspace {
          auto-layout abs; width 1515; height 1044; color #ffffff
          item Header {
            auto-layout row; width 1435; height 56; gap 20; align center; pos 40 -28
            item Title { title "Мои задачи"; width fill; font-size 26; font-weight 600; line-height 32; layout left }
            use Libraries.ui_kit.Actions.Button as Create {
              kind primary
              size medium
              at Button { title "Новая задача" }
              at icon_chevronD { hidden yes }
            }
          }
          use Libraries.tracker_kit.List.IssueList as Table { pos 40 -108 }
          item Support_panel {
            auto-layout row; width 800; padding 16 18; gap 14; align center; color #f8f5fa; border-color #d9b9d8; corner-radius 12; shadow 0 -6 20 #00000014; pos 265 -946
            item Panel_icon {
              auto-layout row; width 40; height 40; align center; justify center; color #efdcf2; corner-radius 10
              use Libraries.ui_kit.Icon.kit_Sparkle as Icon { width 20; height 20; color #8c267d }
            }
            item Panel_text {
              auto-layout column; width fill; gap 4
              item Title { title "Вы уже 4 месяца на бесплатном плане"; font-size 14; font-weight 600; line-height 18; layout left }
              item Text { title "Ресурсов примерно на 1 800 ₽. Если Intabia полезна, поддержите проект."; font-size 12; line-height 17; text-color #5c6470; layout left }
            }
            use Libraries.ui_kit.Actions.Button as Support {
              kind primary
              size small
              at Button { title "Поддержать проект" }
              at icon_kit_Plus { hidden yes }
              at icon_chevronD { hidden yes }
            }
            use Libraries.ui_kit.Icon.kit_Cross as Close { width 16; height 16; color #7f7f7f }
          }
        }
      }
    }
  }
}
