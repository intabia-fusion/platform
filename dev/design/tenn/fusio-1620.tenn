                use Libraries.login_kit.LoginWorkspace as Platform { width 396; name "Intabia Platform"; note "Владелец · сегодня, 16:42" }
                use Libraries.login_kit.LoginWorkspace as Marketing { width 396; name "Маркетинг"; note "Участник · вчера" }
                use Libraries.login_kit.LoginWorkspace as Personal { width 396; name "Личное"; note "Владелец · 28 октября" }
                item Invitation {
                  auto-layout column; gap 12; width 396; padding 16; color #f8f5fa; border-color #d9b9d8; corner-radius 12; clip yes
                  item "inv text" {
                    auto-layout column; gap 4; width fill
                    item T1 { title "Приглашение в «Дизайн-команда»"; font-size 14; font-weight 600; line-height 18; text-color #201240; layout left }
                    item T2 { title "Мария Орлова · роль: участник"; font-size 13; line-height 18; text-color #5c6470; layout left }
                  }
                  item "inv buttons" {
                    auto-layout row; gap 8; width fill; justify end
                    use Libraries.login_kit.LoginButton as Decline {
                      kind default; width 140
                      at Button { title "Отклонить" }
                    }
                    use Libraries.login_kit.LoginButton as Accept {
                      width 140
                      at Button { title "Принять" }
                    }
                  }
                }
                item spacer2 { auto-layout abs; width 396; height 8; clip yes }
                use Libraries.login_kit.LoginButton as "Button Создать" {
                  kind default
                  at Button { title "Создать пространство" }
                }
                use Libraries.login_kit.LoginLinks as Links {
                  slot content {
                    item "link row" {
                      auto-layout row; gap 3; align center; justify center; width 396; wrap yes; line-gap 3
                      item Link { title "Выйти из аккаунта"; font-size 12.8; line-height 17; text-color #333333 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

element "11 Приглашение: продолжение" {
  use Libraries.login_kit.LoginPage as Screen {
    slot Card_slot {
      use Libraries.login_kit.LoginCard as Card {
        slot content {
          use Libraries.login_kit.LoginForm as Form {
            slot content {
              item form {
                auto-layout column; gap 24; width 396; clip yes; font-family "IBM Plex Sans"
                item Heading {
                  auto-layout column; gap 8; width 396; align center
                  item Title { title "Вас приглашают"; font-size 28; font-weight 700; line-height 36; text-color #000061 }
                  item Subtitle { title "Введите почту и код из письма - приглашение сохранится и дождётся вас здесь."; width fill; font-size 14; line-height 18; text-color #5c6470; layout left }
                }
                item "invite chip" {
                  auto-layout row; gap 12; width 396; padding 12; align center; color #f3e5f5; corner-radius 12; clip yes
                  item Mark {
                    auto-layout row; width 40; height 40; align center; justify center; color #cf13a2; corner-radius 20
                    item Letter { title "Д"; font-size 16; font-weight 600; text-color #ffffff }
                  }
                  item "chip text" {
                    auto-layout column; gap 4; width fill
                    item Name { title "Дизайн-команда"; font-size 14; font-weight 600; line-height 18; text-color #201240; layout left }
                    item From { title "Мария Орлова · роль: участник"; font-size 13; line-height 18; text-color #5c6470; layout left }
                  }
                }
                use Libraries.login_kit.LoginButton as "Button Продолжить" {
                  at Button { title "Продолжить" }
                }
                use Libraries.login_kit.LoginLinks as Links {
                  slot content {
                    item "link row" {
                      auto-layout row; gap 3; align center; justify center; width 396; wrap yes; line-gap 3
                      item Link { title "Отклонить приглашение"; font-size 12.8; line-height 17; text-color #333333 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

element "12 Схема: аккаунт и пространства" {
  styles {
    item { font-size 13; color #ffffff; corner-radius 12 }
    line { color #a3a3ad }
    accent { color #efdcf2; text-color #7d1f70 }
  }
  item "Landing: рабочая почта" {
    pos -420 -60
    body "email вводится один раз, на старте продукта"
  }
  item "Существующий: пароль" {
    pos -420 -260
    body "парольный экран с подставленным email"
  }
  item "Код из письма" {
    pos -120 -260
    body "если требуется OTP - для новых и существующих"
  }
  item "Новый аккаунт: профиль" {
    pos -120 -460
    body "имя, фамилия; пространство создаётся в фоне"
  }
  item "Глобальный профиль аккаунта" {
    pos 120 -60
    use-style accent
    body "email, имя, телефон, последнее пространство - один на все"
  }
  item "Первое пространство" {
    pos -120 -660
    body "имя до профиля; создание идёт в фоне"
  }
  item "Последнее пространство" {
    pos 420 -260
    body "сразу после пароля или кода; если нет - выбор или создание"
  }
  item "Приглашения" {
    pos 420 -460
    body "сохраняются, ведут в нужное пространство после входа"
  }
  item "12 Новый flow: email на landing, пароль или код, сразу в последнее пространство" {
    pos -420 100
    display text
    font-size 12
    text-color #5c6470
  }
  link "Landing: рабочая почта" "Существующий: пароль" { display arrow }
  link "Landing: рабочая почта" "Код из письма" { display arrow }
  link "Существующий: пароль" "Последнее пространство" { display arrow }
  link "Код из письма" "Последнее пространство" { display arrow }
  link "Код из письма" "Новый аккаунт: профиль" { display arrow }
  link "Новый аккаунт: профиль" "Глобальный профиль аккаунта" { display arrow }
  link "Новый аккаунт: профиль" "Первое пространство" { display arrow }
  link "Первое пространство" "Последнее пространство" { display arrow }
  link "Глобальный профиль аккаунта" "Последнее пространство" { display arrow }
  link "Приглашения" "Последнее пространство" { display arrow; line-style dashed }
}

element "13 Вход: последнее пространство" {
  item Screen {
    auto-layout abs; width 1920; height 1080; clip yes; color #ffffff
    use Libraries.workbench.Workbench as Workbench {
      pos -0 -1
      slot Main_panel {
        item Workspace {
          auto-layout abs; width 1515; height 1044; color #ffffff
          item Header {
            auto-layout row; width 1435; height 56; gap 20; align center; pos 40 -28
            item Title { title "Intabia Platform"; width fill; font-size 26; font-weight 600; line-height 32; layout left }
            item Hint { title "последнее активное пространство"; font-size 12; line-height 16; text-color #7f7f7f }
          }
          item Panel {
            auto-layout row; width 800; padding 16 18; gap 14; align center; color #f8f5fa; border-color #d9b9d8; corner-radius 12; pos 265 -946
            item Panel_icon {
              auto-layout row; width 40; height 40; align center; justify center; color #efdcf2; corner-radius 10
              use Libraries.ui_kit.Icon.kit_Person as Icon { width 20; height 20; color #8c267d }
            }
            item Panel_text {
              auto-layout column; width fill; gap 4
              item Title { title "Вы вошли сразу в последнее активное пространство"; font-size 14; font-weight 600; line-height 18; layout left }
              item Text { title "Если последнего нет - покажем выбор или создание. Сменить пространство: меню профиля."; font-size 12; line-height 17; text-color #5c6470; layout left }
            }
          }
        }
      }
    }
  }
}

element "23 Черновик: маршрут входа (устарел)" {
  item Screen {
    auto-layout column; width 1920; height 1080; padding 56; gap 24; color #f7f7fa
    item Header {
      auto-layout column; width fill; gap 8
      item Title { title "Черновик до landing (устарел): вход и первый запуск"; font-size 30; font-weight 600; line-height 38; layout left }
      item Subtitle { title "Пользователь попадает в личный профиль или сразу в пространство в зависимости от способа входа"; font-size 15; line-height 22; text-color #5c6470; layout left }
    }
    item Routes {
      auto-layout column; width fill; height fill; gap 20
      item Sign_in {
        auto-layout row; width fill; height fill; padding 24; gap 16; align center; color #ffffff; border-color #00000014; corner-radius 12
        item Route_label {
          auto-layout column; width 220; gap 6
          item Number { title "01"; font-size 12; font-weight 600; line-height 16; text-color #8c267d; layout left }
          item Title { title "Обычный вход"; font-size 18; font-weight 600; line-height 24; layout left }
          item Hint { title "У пользователя уже есть аккаунт"; width 200; font-size 13; line-height 18; text-color #7f7f7f; layout left }
        }
        item Login_card {
          auto-layout column; width fill; height fill; padding 20; gap 8; justify center; color #f8f5fa; corner-radius 10
          item Step { title "ВХОД"; font-size 11; font-weight 600; line-height 14; text-color #8c267d; layout left }
          item Title { title "Email или GitHub"; font-size 17; font-weight 600; line-height 23; layout left }
          item Text { title "Вход в существующий аккаунт"; width fill; font-size 13; line-height 18; text-color #5c6470; layout left }
        }
        item Arrow_1 { title ">"; width 24; font-size 24; text-color #a3a3ad }
        item Profile_card {
          auto-layout column; width fill; height fill; padding 20; gap 8; justify center; color #f8f5fa; corner-radius 10
          item Step { title "ЛИЧНЫЙ КАБИНЕТ"; font-size 11; font-weight 600; line-height 14; text-color #8c267d; layout left }
          item Title { title "Профиль и пространства"; font-size 17; font-weight 600; line-height 23; layout left }
          item Text { title "Личные данные и доступные пространства"; width fill; font-size 13; line-height 18; text-color #5c6470; layout left }
        }
        item Arrow_2 { title ">"; width 24; font-size 24; text-color #a3a3ad }
        item Workspace_card {
          auto-layout column; width fill; height fill; padding 20; gap 8; justify center; color #efdcf2; corner-radius 10
          item Step { title "РАБОТА"; font-size 11; font-weight 600; line-height 14; text-color #7d1f70; layout left }
          item Title { title "Выбранное пространство"; font-size 17; font-weight 600; line-height 23; layout left }
          item Text { title "Переход в рабочий интерфейс"; width fill; font-size 13; line-height 18; text-color #5c6470; layout left }
        }
      }
      item Registration {
        auto-layout row; width fill; height fill; padding 24; gap 16; align center; color #ffffff; border-color #00000014; corner-radius 12
        item Route_label {
          auto-layout column; width 220; gap 6
          item Number { title "02"; font-size 12; font-weight 600; line-height 16; text-color #8c267d; layout left }
          item Title { title "Регистрация"; font-size 18; font-weight 600; line-height 24; layout left }
          item Hint { title "Первый вход нового пользователя"; width 200; font-size 13; line-height 18; text-color #7f7f7f; layout left }
        }
        item Signup_card {
          auto-layout column; width fill; height fill; padding 20; gap 8; justify center; color #f8f5fa; corner-radius 10
          item Step { title "РЕГИСТРАЦИЯ"; font-size 11; font-weight 600; line-height 14; text-color #8c267d; layout left }
          item Title { title "Создание аккаунта"; font-size 17; font-weight 600; line-height 23; layout left }
          item Text { title "Email, имя и пароль"; width fill; font-size 13; line-height 18; text-color #5c6470; layout left }
        }
        item Arrow_1 { title ">"; width 24; font-size 24; text-color #a3a3ad }
        item Profile_card {
          auto-layout column; width fill; height fill; padding 20; gap 8; justify center; color #f8f5fa; corner-radius 10
          item Step { title "ПЕРВЫЙ ШАГ"; font-size 11; font-weight 600; line-height 14; text-color #8c267d; layout left }
          item Title { title "Пустой профиль"; font-size 17; font-weight 600; line-height 23; layout left }
          item Text { title "Заполнение личных данных"; width fill; font-size 13; line-height 18; text-color #5c6470; layout left }
        }
        item Arrow_2 { title ">"; width 24; font-size 24; text-color #a3a3ad }
        item Workspace_card {
          auto-layout column; width fill; height fill; padding 20; gap 8; justify center; color #efdcf2; corner-radius 10
          item Step { title "ВТОРОЙ ШАГ"; font-size 11; font-weight 600; line-height 14; text-color #7d1f70; layout left }
          item Title { title "Первое пространство"; font-size 17; font-weight 600; line-height 23; layout left }
          item Text { title "Создание пространства и вход в него"; width fill; font-size 13; line-height 18; text-color #5c6470; layout left }
        }
      }
      item Invitation {
        auto-layout row; width fill; height fill; padding 24; gap 16; align center; color #ffffff; border-color #00000014; corner-radius 12
        item Route_label {
          auto-layout column; width 220; gap 6
          item Number { title "03"; font-size 12; font-weight 600; line-height 16; text-color #8c267d; layout left }
          item Title { title "Ссылка на пространство"; font-size 18; font-weight 600; line-height 24; layout left }
          item Hint { title "Приглашение или прямая ссылка"; width 200; font-size 13; line-height 18; text-color #7f7f7f; layout left }
        }
        item Link_card {
          auto-layout column; width fill; height fill; padding 20; gap 8; justify center; color #f8f5fa; corner-radius 10
          item Step { title "ССЫЛКА"; font-size 11; font-weight 600; line-height 14; text-color #8c267d; layout left }
          item Title { title "Открытие приглашения"; font-size 17; font-weight 600; line-height 23; layout left }
          item Text { title "Вход или регистрация при необходимости"; width fill; font-size 13; line-height 18; text-color #5c6470; layout left }
        }
        item Arrow_1 { title ">"; width 24; font-size 24; text-color #a3a3ad }
        item Workspace_card {
          auto-layout column; width fill; height fill; padding 20; gap 8; justify center; color #efdcf2; corner-radius 10
          item Step { title "СРАЗУ В РАБОТУ"; font-size 11; font-weight 600; line-height 14; text-color #7d1f70; layout left }
          item Title { title "Пространство из ссылки"; font-size 17; font-weight 600; line-height 23; layout left }
          item Text { title "Личный кабинет не перехватывает переход"; width fill; font-size 13; line-height 18; text-color #5c6470; layout left }
        }
        item Arrow_2 { title ">"; width 24; font-size 24; text-color #a3a3ad }
        item Profile_card {
          auto-layout column; width fill; height fill; padding 20; gap 8; justify center; color #f8f5fa; corner-radius 10
          item Step { title "ПО ЗАПРОСУ"; font-size 11; font-weight 600; line-height 14; text-color #8c267d; layout left }
          item Title { title "Меню аккаунта"; font-size 17; font-weight 600; line-height 23; layout left }
          item Text { title "Переход в профиль из рабочего интерфейса"; width fill; font-size 13; line-height 18; text-color #5c6470; layout left }
        }
      }
    }
    item Note {
      auto-layout row; width fill; padding 16 20; gap 12; align center; color #efdcf2; corner-radius 10
      use Libraries.ui_kit.Icon.kit_Person as Icon { width 20; height 20; color #7d1f70 }
      item Text { title "Личный профиль и подписки принадлежат аккаунту, а не отдельному пространству"; width fill; font-size 14; line-height 20; text-color #7d1f70; layout left }
    }
  }
}

element "24 Архив: сравнения и альтернативы" {
  element "Сравнение 1: Старт - табы против почты" --from-file "cmp-1620-start.tenn"
element "Сравнение 2: Регистрация - длинная против минимальной" --from-file "cmp-1620-signup.tenn"
element "Сравнение 3: Пространства - список против профиля" --from-file "cmp-1620-workspace.tenn"
element "Сравнение 4: Код - сноска против равного пути" --from-file "cmp-1620-otp.tenn"
element "Сравнение 5: После кода - профиль и пространство (A/B)" --from-file "cmp-1620-after-otp.tenn"
element "Сравнение 6: Landing - кнопка против email-старта" --from-file "cmp-1620-landing.tenn"
}
