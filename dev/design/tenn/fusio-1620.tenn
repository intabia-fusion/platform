          item Value { title "229 КБ из 10 ГБ"; font-size 13; line-height 19; text-color #5c6470 }
        }
        item Bar { auto-layout row; width fill; height 6; color #ececf1; corner-radius 3; clip yes; item Value { width 4; height fill; color #8bb34a } }
      }
      item Tokens {
        auto-layout column; width fill; gap 7
        item Row {
          auto-layout row; width fill
          item Label { title "Доступно"; width fill; font-size 14; line-height 19; layout left }
          item Value { title "99.7K"; font-size 13; line-height 19; text-color #5c6470 }
        }
        item Bar { auto-layout row; width fill; height 6; color #ececf1; corner-radius 3; clip yes; item Value { width 4; height fill; color #8bb34a } }
      }
      item Token_month {
        auto-layout row; width fill
        item Label { title "Токены ИИ (месяц)"; width fill; font-size 13; line-height 18; text-color #5c6470; layout left }
        item Value { title "273 / 100K"; font-size 13; line-height 18; text-color #5c6470 }
      }
      item Reset { title "сброс в эту минуту"; font-size 12; line-height 16; text-color #7f7f7f; layout left }
      item divider { width fill; height 1; color #0000000f }
      item Support {
        auto-layout column; width fill; padding 12; gap 8; color #f8f5fa; border-color #d9b9d8; corner-radius 8
        item Title { title "4 месяца на бесплатном тарифе"; font-size 13; font-weight 600; line-height 18; layout left }
        item Text { title "Ресурсов примерно на 1 800 ₽. Если Intabia полезна, поддержите проект."; width fill; font-size 12; line-height 17; text-color #5c6470; layout left }
        use Libraries.ui_kit.Actions.Button as Action {
          kind primary
          size small
          at Button { title "Поддержать проект" }
          at icon_kit_Plus { hidden yes }
