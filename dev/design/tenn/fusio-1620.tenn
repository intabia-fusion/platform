        slot content {
          use Libraries.login_kit.LoginForm as Form {
            slot content {
              item form {
                auto-layout column; gap 20; width 396; clip yes; font-family "IBM Plex Sans"
                item Heading {
                  auto-layout column; gap 8; width 396; align center
                  item Title { title "С возвращением"; font-size 28; font-weight 700; line-height 36; text-color #000061 }
