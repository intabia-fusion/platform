						at icon_chevronD { hidden no }
					}
				}
				slot right {
					use Libraries.ui_kit.Status.Notice as "Notice/warning" {
						kind warning; corner-radius 14
						at Notice_text { title "1 статус без колонки · 1 задача не видна" }
