					}
					use Libraries.ui_kit.TagsAndFilters.QuickFilter as "QuickFilter/Блокеры" {
						at Only_mine { title Блокеры }
					}
				}
			}
			item Board {
				auto-layout column; gap 8; padding 12 16 0 16; width 1515; height 931; clip yes; pos 0 -113
				item "Column headers" {
					auto-layout row; gap 12; width 1483; clip yes
					item "Column To Do" {
						auto-layout column; gap 6; width 234; clip yes
						use Libraries.tracker_kit.Kanban.ColumnHeader as "ColumnHeader To Do" {
							padding 0 8 0 20; width 234; color #d8dbe1
