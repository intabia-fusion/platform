						at body { width 1218 }
						slot head {
							item th {
								auto-layout row; padding 0 12; align center; width 90; height 36; clip yes
								item Цвет { title Цвет; font-size 12; line-height 15; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #00000099 }
							}
							item th {
								auto-layout row; padding 0 12; align center; width 1072; height 36; clip yes
								item Условие { title Условие; font-size 12; line-height 15; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #00000099 }
							}
							item th {
								auto-layout row; padding 0 12; align center; width 56; height 36; clip yes
								item spacer { auto-layout abs; width 1; height 1; clip yes }
							}
						}
						slot body {
							item divider { auto-layout abs; width 1218; height 1; clip yes; color #0000000f }
							item row {
								auto-layout row; align center; width 1218; clip yes
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 90; clip yes; wrap yes; line-gap 6
									item c {
										auto-layout row; gap 6; align center; clip yes
										use Libraries.ui_kit.Icon.drag as "icon/drag" { border-color #00000066; line-width 1 }
										use Libraries.ui_kit.TagsAndFilters.Swatch as Swatch
									}
								}
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 1072; clip yes; wrap yes; line-gap 6
									item c {
										auto-layout row; gap 6; align center; clip yes
										use Libraries.ui_kit.TagsAndFilters.FilterChip as "FilterChip/Статус" {
											at part.Priority { title Статус }
											at part_2.in { title "=" }
											at part_3.Urgent__High { title "Ready for QA" }
										}
										use Libraries.ui_kit.TagsAndFilters.FilterChip as "FilterChip/В статусе" {
											at part.Priority { title "В статусе" }
											at part_2.in { title ">" }
											at part_3.Urgent__High { title "5 дн." }
										}
									}
								}
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 56; clip yes; wrap yes; line-gap 6
									use Libraries.ui_kit.Actions.Button as "IconButton/trash" {
										kind tertiary; size extra-small; shape icon
										replace icon_gear {
											use Libraries.ui_kit.Icon.trash as "icon/trash" { border-color #5a667e; line-width 1 }
										}
									}
								}
							}
							item divider { auto-layout abs; width 1218; height 1; clip yes; color #0000000f }
							item row {
								auto-layout row; align center; width 1218; clip yes
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 90; clip yes; wrap yes; line-gap 6
									item c {
										auto-layout row; gap 6; align center; clip yes
										use Libraries.ui_kit.Icon.drag as "icon/drag" { border-color #00000066; line-width 1 }
										use Libraries.ui_kit.TagsAndFilters.Swatch as Swatch { color #d15045 }
									}
								}
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 1072; clip yes; wrap yes; line-gap 6
									item c {
										auto-layout row; gap 6; align center; clip yes
										use Libraries.ui_kit.TagsAndFilters.FilterChip as "FilterChip/Статус" {
											at part.Priority { title Статус }
											at part_2.in { title "=" }
											at part_3.Urgent__High { title "Peer Review" }
										}
										use Libraries.ui_kit.TagsAndFilters.FilterChip as "FilterChip/В статусе" {
											at part.Priority { title "В статусе" }
											at part_2.in { title ">" }
											at part_3.Urgent__High { title "3 дн." }
										}
									}
								}
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 56; clip yes; wrap yes; line-gap 6
									use Libraries.ui_kit.Actions.Button as "IconButton/trash" {
										kind tertiary; size extra-small; shape icon
										replace icon_gear {
											use Libraries.ui_kit.Icon.trash as "icon/trash" { border-color #5a667e; line-width 1 }
										}
									}
								}
							}
						}
					}
					use Libraries.ui_kit.Actions.Button as "Button/secondary/small" {
						kind secondary; size small
						replace icon_kit_Plus {
							use Libraries.ui_kit.Icon.plus as "icon/plus" { border-color #000000; line-width 1 }
						}
						at Button { title Правило }
					}
					item Пример { title Пример; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; auto-layout row; text-color #00000066 }
					item Preview {
						auto-layout row; gap 12; width 720; clip yes
						use Libraries.tracker_kit.Cards.IssueCard as "IssueCard APP-29" {
							width 264; border-color #d27540; line-width 2
							at top.left.id { title APP-29 }
							replace top.Avatar_20 {
								use Libraries.ui_kit.People.Avatar as "Avatar/20" {
									color #83af12; corner-radius 10
									at initials { title КМ; font-size 8; line-height 10 }
								}
							}
							replace title_row.StatusIcon_active {
								item "StatusIcon/active" {
									auto-layout abs; width 16; height 16
									item ring { width 14; height 14; corner-radius 7; border-color #5195d7; line-width 1.5; pos 1 -1 }
									item wedge { width 16; height 16; path "M8 8L8 3A5 5 0 0 1 13 8Z"; view-box 0 0 16 16; color #5195d7 }
								}
							}
							at title_row.title { title "Ссылки на товар из внешних источников" }
							at chips { width 234 }
							at footer { title "Оценка 3h" }
							slot chips {
								item priority {
									auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
									use Libraries.ui_kit.Status.PriorityIcon as "Status/PriorityIcon/medium" { priority medium }
								}
							}
						}
						use Libraries.tracker_kit.Cards.IssueCard as "IssueCard APP-27" {
							width 264; border-color #d15045; line-width 2
							at top.left.id { title APP-27 }
							replace top.Avatar_20 {
								use Libraries.ui_kit.People.Avatar as "Avatar/20" {
									color #db877d; corner-radius 10
									at initials { title ПИ; font-size 8; line-height 10 }
								}
							}
							replace title_row.StatusIcon_active {
								item "StatusIcon/active" {
									auto-layout abs; width 16; height 16
									item ring { width 14; height 14; corner-radius 7; border-color #5195d7; line-width 1.5; pos 1 -1 }
									item wedge { width 16; height 16; path "M8 8L8 3A5 5 0 0 1 13 8Z"; view-box 0 0 16 16; color #5195d7 }
								}
							}
							at title_row.title { title "Проверка количества товара в корзине" }
							at chips { width 234 }
							at footer { title "Оценка 3h" }
							slot chips {
