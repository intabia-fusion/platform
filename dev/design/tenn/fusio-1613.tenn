					item "button kit/DotsHorizontal" {
						auto-layout row; align center; justify center; width 32; height 32; clip yes; color #1725470d; border-color #1725471a; corner-radius 6
						use Libraries.ui_kit.Icon.kit_DotsHorizontal as "icon/kit/DotsHorizontal" { color #000000 }
					}
				}
				slot filters {
					item Filter {
						auto-layout row; gap 6; padding 0 12; align center; height 32; clip yes; color #6b3ad31a; border-color #00000017; corner-radius 6
						use Libraries.ui_kit.Icon.kit_Funnel as "icon/kit/Funnel" { color #000000cc }
						item Filter { title Filter; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #000000cc }
					}
					item Search {
						auto-layout row; align center; justify center; width 32; height 32; clip yes; color #6b3ad31a; border-color #00000017; corner-radius 6
						use Libraries.ui_kit.Icon.kit_Search as "icon/kit/Search" { color #0f121a }
					}
					item sep { auto-layout abs; width 1; height 20; clip yes; color #0000000f }
					use Libraries.ui_kit.TagsAndFilters.QuickFilter as "QuickFilter/Только мои" {
						at Only_mine { title "Только мои" }
					}
					use Libraries.ui_kit.TagsAndFilters.QuickFilter as "QuickFilter/Разработка" {
						at Only_mine { title Разработка }
					}
					use Libraries.ui_kit.TagsAndFilters.QuickFilter as "QuickFilter/Тестирование" {
						on true
						at Only_mine { title Тестирование }
					}
					use Libraries.ui_kit.TagsAndFilters.QuickFilter as "QuickFilter/iOS" {
						at Only_mine { title iOS }
					}
					use Libraries.ui_kit.TagsAndFilters.QuickFilter as "QuickFilter/Срочные" {
