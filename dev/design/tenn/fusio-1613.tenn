						}
						at Button { title "К доске" }
					}
				}
				at Settings_header.left.Settings { title "Настройки доски" }
				at divider { width 1515 }
				at Settings_tabs { height 987 }
				at divider_2 { height 987 }
				at Settings_subtabs { hidden no; auto-layout column; gap 16; padding 24 32; align start; width 1282; height 987 }
				at Settings_content { hidden yes }
				slot right {
					use Libraries.ui_kit.Actions.Button as "Board in settings" {
						kind ghost; size small
						replace icon_kit_Plus {
							use Libraries.ui_kit.Icon.board as "icon/board" { border-color #5a667e; line-width 1 }
						}
						at Button { title "Основная доска" }
						at icon_chevronD { hidden no }
