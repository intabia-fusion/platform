		slot Main_panel {
			use Libraries.settings_kit.SettingsLayout as Settings {
				width 1515; height 1044
				at Settings_header { width 1515 }
				replace Settings_header.left.Button_ghost_small {
					use Libraries.ui_kit.Actions.Button as "Button/ghost/small" {
						kind ghost; size small
						replace icon_kit_Plus {
