				slot Settings_subtabs {
					use Libraries.settings_kit.SectionTitle as "Section Дорожки" {
						at Title { title Дорожки }
						at Hint_of_the_section {
							hidden no; title "Горизонтальная группировка задач на доске. Пользователь может переключить дорожки у себя в параметрах вида."; width 720
						}
					}
					item "Swimlane by" {
						auto-layout column; gap 12; width 720; clip yes
						use Libraries.ui_kit.Forms.Radio as "Radio Нет" {
							on false
							at text.Label { title Нет }
						}
						use Libraries.ui_kit.Forms.Radio as "Radio Исполнитель" {
							on false
							at text.Label { title Исполнитель }
						}
						use Libraries.ui_kit.Forms.Radio as "Radio Приоритет" {
							on false
							at text.Label { title Приоритет }
						}
						use Libraries.ui_kit.Forms.Radio as "Radio Компонент · Веха · Родительская задача" {
							on false
							at text.Label { title "Компонент · Веха · Родительская задача" }
						}
						use Libraries.ui_kit.Forms.Radio as "Radio По фильтрам" {
							at text.Label { title "По фильтрам" }
							at text.Hint { hidden no; title "Задача попадает в первую подходящую дорожку" }
						}
					}
					use Libraries.settings_kit.Table as "Swimlanes table" {
						width 1218
						at head { width 1218 }
						at body { width 1218 }
						slot head {
							item th {
								auto-layout row; padding 0 12; align center; width 240; height 36; clip yes
								item Дорожка { title Дорожка; font-size 12; line-height 15; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #00000099 }
							}
							item th {
								auto-layout row; padding 0 12; align center; width 922; height 36; clip yes
								item Условие { title Условие; font-size 12; line-height 15; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #00000099 }
							}
							item th {
								auto-layout row; padding 0 12; align center; width 56; height 36; clip yes
								item spacer { auto-layout abs; width 1; height 1; clip yes }
							}
						}
						slot body {
							item divider { auto-layout abs; width 1218; height 1; clip yes; color #0000000f }
							item row {
								auto-layout row; align center; width 1218; clip yes
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 240; clip yes; wrap yes; line-gap 6
									item name {
										auto-layout row; gap 8; align center; clip yes
										use Libraries.ui_kit.Icon.drag as "icon/drag" { border-color #00000066; line-width 1 }
										item Внеочередные { title Внеочередные; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 500; layout left }
									}
								}
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 922; clip yes; wrap yes; line-gap 6
									item c {
										auto-layout row; gap 6; align center; clip yes
										use Libraries.ui_kit.TagsAndFilters.FilterChip as "FilterChip/Приоритет" {
											at part.Priority { title Приоритет }
											at part_2.in { title "=" }
											at part_3.Urgent__High { title Urgent }
										}
									}
								}
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 56; clip yes; wrap yes; line-gap 6
									use Libraries.ui_kit.Actions.Button as "IconButton/trash" {
										kind tertiary; size extra-small; shape icon
										replace icon_gear {
											use Libraries.ui_kit.Icon.trash as "icon/trash" { border-color #5a667e; line-width 1 }
										}
									}
								}
							}
							item divider { auto-layout abs; width 1218; height 1; clip yes; color #0000000f }
							item row {
								auto-layout row; align center; width 1218; clip yes
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 240; clip yes; wrap yes; line-gap 6
									item name {
										auto-layout row; gap 8; align center; clip yes
										use Libraries.ui_kit.Icon.drag as "icon/drag" { border-color #00000066; line-width 1 }
										item "Ждут ревью дольше 3 дней" {
											title "Ждут ревью дольше 3 дней"; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 500; layout left
										}
									}
								}
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 922; clip yes; wrap yes; line-gap 6
									item c {
										auto-layout row; gap 6; align center; clip yes
										use Libraries.ui_kit.TagsAndFilters.FilterChip as "FilterChip/Статус" {
											at part.Priority { title Статус }
											at part_2.in { title "=" }
											at part_3.Urgent__High { title "Peer Review" }
										}
										use Libraries.ui_kit.TagsAndFilters.FilterChip as "FilterChip/В статусе" {
											at part.Priority { title "В статусе" }
											at part_2.in { title ">" }
											at part_3.Urgent__High { title "3 дн." }
										}
									}
								}
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 56; clip yes; wrap yes; line-gap 6
									use Libraries.ui_kit.Actions.Button as "IconButton/trash" {
										kind tertiary; size extra-small; shape icon
										replace icon_gear {
											use Libraries.ui_kit.Icon.trash as "icon/trash" { border-color #5a667e; line-width 1 }
										}
									}
								}
							}
							item divider { auto-layout abs; width 1218; height 1; clip yes; color #0000000f }
							item row {
								auto-layout row; align center; width 1218; clip yes
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 240; clip yes; wrap yes; line-gap 6
									item name {
										auto-layout row; gap 8; align center; clip yes
										use Libraries.ui_kit.Icon.drag as "icon/drag" { border-color #0000004d; line-width 1 }
										item "Все остальные" { title "Все остальные"; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 500; layout left }
									}
								}
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 922; clip yes; wrap yes; line-gap 6
									item "всё, что не попало выше" {
										title "всё, что не попало выше"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000066
									}
								}
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 56; clip yes; wrap yes; line-gap 6
									item spacer { auto-layout abs; width 1; height 1; clip yes }
								}
							}
						}
					}
					use Libraries.ui_kit.Actions.Button as "Button/secondary/small" {
						kind secondary; size small
						replace icon_kit_Plus {
							use Libraries.ui_kit.Icon.plus as "icon/plus" { border-color #000000; line-width 1 }
						}
						at Button { title "Добавить дорожку" }
					}
					item "Lane example" {
						auto-layout column; gap 6; padding 14 16; width 720; clip yes; color #f7f7f8; corner-radius 8
						item "Пример: APP-6 «Интеграция с платёжным пр" {
							title "Пример: APP-6 «Интеграция с платёжным провайдером», приоритет Urgent"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600
							layout left
						}
						item "1. Внеочередные: условие выполнено, зада" {
							title "1. Внеочередные: условие выполнено, задача идёт в эту дорожку"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left
						}
						item "2. Ждут ревью дольше 3 дней: не проверяе" {
							title "2. Ждут ревью дольше 3 дней: не проверяется, дорожка уже найдена"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left
							text-color #00000066
						}
						item "3. Все остальные: сюда попадают задачи, " {
							title "3. Все остальные: сюда попадают задачи, не подошедшие ни под одно условие выше"; font-size 13; line-height 16; font-family "IBM Plex Sans"
							layout left; text-color #00000066
						}
					}
				}
			}
		}
	}
