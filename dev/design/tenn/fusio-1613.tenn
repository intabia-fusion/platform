									auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
									use Libraries.ui_kit.Status.PriorityIcon as "Status/PriorityIcon/high" { priority high }
								}
							}
						}
					}
				}
			}
		}
	}
	use Libraries.workbench.Workbench as "Настройка доски - Карточка" {
