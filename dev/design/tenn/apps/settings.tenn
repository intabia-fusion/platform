						}
						at Issues { title Integrations }
					}
					use workbench.NavItem as "NavItem/Notifications" {
						pos 13 -164
						replace icon_kit_CheckSquare {
							use ui_kit.Icon.kit_Bell as "icon/kit/Bell" { color #0f121a }
						}
						at Issues { title Notifications }
					}
					use workbench.NavItem as "NavItem/Auto translation" {
						pos 13 -196
						replace icon_kit_CheckSquare {
							use ui_kit.Icon.kit_Translate as "icon/kit/Translate" { color #0f121a }
						}
						at Issues { title "Auto translation" }
					}
					use workbench.NavItem as "NavItem/Calendar" {
						pos 13 -228
						replace icon_kit_CheckSquare {
							use ui_kit.Icon.kit_Calendar as "icon/kit/Calendar" { color #0f121a }
						}
						at Issues { title Calendar }
					}
					use workbench.NavItem as "NavItem/Office" {
						pos 13 -260
						replace icon_kit_CheckSquare {
							use ui_kit.Icon.kit_Building as "icon/kit/Building" { color #0f121a }
						}
						at Issues { title Office }
					}
					use workbench.NavItem as "NavItem/Sidebar Menu Settings" {
						pos 13 -292
						replace icon_kit_CheckSquare {
							use ui_kit.Icon.kit_Gear as "icon/kit/Gear" { color #0f121a }
						}
						at Issues { title "Sidebar Menu Settings" }
					}
					use workbench.NavItem as "NavItem/Mailboxes" {
						pos 13 -324
						replace icon_kit_CheckSquare {
							use ui_kit.Icon.kit_Mailbox as "icon/kit/Mailbox" { color #0f121a }
						}
						at Issues { title Mailboxes }
					}
					use workbench.NavItem as "NavItem/AI settings" {
						pos 13 -356
						replace icon_kit_CheckSquare {
							use ui_kit.Icon.kit_Sparkle as "icon/kit/Sparkle" { color #0f121a }
						}
						at Issues { title "AI settings" }
					}
					item divider { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -400 }
					use workbench.NavCaption_highlighted as "NavCaption Workspace settings" {
						pos 16 -411
						at Channels { title "WORKSPACE SETTINGS" }
					}
					use workbench.NavItem as "NavItem/General" {
						pos 13 -441
						replace icon_kit_CheckSquare {
							use ui_kit.Icon.kit_Gear as "icon/kit/Gear" { color #0f121a }
						}
						at Issues { title General }
					}
					use workbench.NavItem as "NavItem/Billing" {
						pos 13 -473
						replace icon_kit_CheckSquare {
							use ui_kit.Icon.kit_Receipt as "icon/kit/Receipt" { color #0f121a }
						}
						at Issues { title Billing }
					}
					use workbench.NavItem as "NavItem/Backup" {
						pos 13 -505
						replace icon_kit_CheckSquare {
							use ui_kit.Icon.kit_Gear as "icon/kit/Gear" { color #0f121a }
						}
						at Issues { title Backup }
					}
					use workbench.NavItem as "NavItem/API + Webhooks" {
						pos 13 -537
						replace icon_kit_CheckSquare {
							use ui_kit.Icon.kit_Gear as "icon/kit/Gear" { color #0f121a }
						}
						at Issues { title "API + Webhooks" }
					}
					use workbench.NavItem_selected as "NavItem/Members" {
						pos 13 -569
						replace icon_kit_CheckSquare {
