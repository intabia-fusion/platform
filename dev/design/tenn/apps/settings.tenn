		slot Main_panel {
			use workbench.PanelHeader as "Panel header" {
				width 1515
				at Panel_header { width 1515 }
				at divider { width 1515 }
				slot actions {}
			}
			item Content {
				auto-layout column; width 1024; clip yes; pos 246 -81
				item "Member Anna Smith" {
					auto-layout row; padding 8; align center; width 1024; height 48; clip yes
					item who {
						auto-layout row; gap 8; padding 4; align center; width 320; height 32; clip yes
						use ui_kit.People.Avatar as "Avatar/24" {
							width 24; height 24; color #925cb1; corner-radius 5
							at initials { title SA; font-size 10; line-height 13 }
						}
						item "Anna Smith" { title "Anna Smith"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
					}
					use ui_kit.Actions.ClassicButton as "ClassicButton/primary/medium" { kind ghost; size medium;
						color #cf13a21f
						at icon_kit_Plus { hidden yes }
						at Button { title Owner; text-color #000000 }
						at icon_kit_CaretDownFill { hidden no; color #000000 }
					}
				}
				item "Member Maria Cole" {
					auto-layout row; padding 8; align center; width 1024; height 48; clip yes
					item who {
						auto-layout row; gap 8; padding 4; align center; width 320; height 32; clip yes
						use ui_kit.People.Avatar as "Avatar/24" {
							width 24; height 24; color #758595; corner-radius 5
							at initials { title CM; font-size 10; line-height 13 }
						}
						item "Maria Cole" { title "Maria Cole"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
					}
					use ui_kit.Actions.ClassicButton as "ClassicButton/primary/medium" { kind primary; size medium;
						at icon_kit_Plus { hidden yes }
						at Button { title Owner }
						at icon_kit_CaretDownFill { hidden no }
					}
				}
			}
