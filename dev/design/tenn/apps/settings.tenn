						pos 13 -961
						replace icon_kit_CheckSquare {
							use ui_kit.Icon.kit_PersonPlus as "icon/kit/PersonPlus" { color #0f121a }
						}
						at Issues { title "Invite to workspace" }
					}
					use workbench.NavItem as "NavItem/Sign out" {
						pos 13 -993
						replace icon_kit_CheckSquare {
							use ui_kit.Icon.kit_ArrowOut as "icon/kit/ArrowOut" { color #0f121a }
						}
						at Issues { title "Sign out" }
