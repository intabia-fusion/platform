						slot content {
							use Libraries.login_kit.LoginTitle as Title {
								at Subtitle { title "Восстановление пароля"; font-size 28; line-height 36; font-weight 700; text-color #333333 }
								at Title { hidden yes }
							}
							item form {
								auto-layout column; gap 24; padding 24 0 0 0; width 396; clip yes
								use Libraries.login_kit.LoginField as "Field Email" {
									at Label { title Email; pos 21 -17 }
									at Value { hidden yes }
								}
