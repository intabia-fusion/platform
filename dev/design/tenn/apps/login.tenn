		item "Card slot" {
			auto-layout row; align center; justify center; width 1920; height 1080
			use Libraries.login_kit.LoginCard as "Login card" {
				slot content {
					use Libraries.login_kit.LoginForm as "Login form" {
						padding 16
						slot content {
							use Libraries.login_kit.LoginBackTitle as "Back title" {
								at Title { title "Выбрать рабочее пространство" }
							}
							item person {
								auto-layout column; padding 8 0 12 0; width 428; clip yes
								item "Анна Смирнова" {
									title "Анна Смирнова"; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #201240
								}
							}
							item spacer { auto-layout abs; width 428; height 20; clip yes }
							item workspaces {
								auto-layout column; padding 2 0 14 0; width 428; clip yes
								use Libraries.login_kit.LoginWorkspace as "Workspace demo-ws" {
									at Workspace { title demo-ws }
									at last_visit_2_days_ago { title "(2 days)" }
								}
							}
							item footer {
								auto-layout column; padding 56 0 0 0; width 428; clip yes
								use Libraries.login_kit.LoginLinks as Links {
									align start; width 428
									slot content {
										item "link row" {
											auto-layout row; gap 3; align center; width 428; clip yes; wrap yes; line-gap 3
											item "Хотите создать другое рабочее пространст" {
												title "Хотите создать другое рабочее пространство?"; font-size 12.8; line-height 17; font-family "IBM Plex Sans"; layout left; text-color #000061cc
											}
											item "Создать рабочее пространство" {
												title "Создать рабочее пространство"; font-size 12.8; line-height 17; font-family "IBM Plex Sans"; layout left; text-color #6e48cecc
											}
										}
										item "link row" {
											auto-layout row; gap 3; align center; width 428; clip yes; wrap yes; line-gap 3
											item "Не видите ваше рабочее пространство?" {
												title "Не видите ваше рабочее пространство?"; font-size 12.8; line-height 17; font-family "IBM Plex Sans"; layout left; text-color #000061cc
											}
											item "Сменить пользователя" {
