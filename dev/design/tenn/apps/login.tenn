		item Copyright {
			auto-layout row; gap 4; align center; clip yes; pos 28 -1045.5
			item "© 2026," { title "© 2026,"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #3c4149 }
			item "Интабия Фьюжн" { title "Интабия Фьюжн"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #333333 }
		}
		item "Card slot" {
			auto-layout row; align center; justify center; width 1920; height 1080
			use Libraries.login_kit.LoginCard as "Login card" {
				slot content {
					use Libraries.login_kit.LoginForm as "Login form" {
						slot content {
							use Libraries.login_kit.LoginTabs as Tabs {
								at heading.Platform { title "Интабия Платформа" }
								at tabs.Tab_Sign_up.Sign_up { title Регистрация; font-weight 600 }
								at tabs.Tab_Sign_up.underline { color #cf13a2 }
								at tabs.Tab_Log_In.Log_In { title Вход; font-weight 500 }
								at tabs.Tab_Log_In.underline { color #00000000 }
							}
							item form {
								auto-layout column; gap 24; padding 24 0 0 0; width 396; clip yes
								use Libraries.login_kit.LoginField as "Field Имя" {
									at Label { title Имя; pos 21 -17 }
									at Value { hidden yes }
								}
								use Libraries.login_kit.LoginField as "Field Фамилия" {
									at Label { title Фамилия; pos 21 -17 }
									at Value { hidden yes }
								}
								use Libraries.login_kit.LoginField as "Field Email" {
									at Label { title Email; pos 21 -17 }
									at Value { hidden yes }
								}
								use Libraries.login_kit.LoginField as "Field Номер телефона" {
									at Label { title "Номер телефона"; pos 21 -17 }
									at Value { hidden yes }
								}
								use Libraries.login_kit.LoginField as "Field Пароль" {
									at Label { title Пароль; pos 21 -17 }
									at Value { hidden yes }
								}
								use Libraries.login_kit.LoginField as "Field Повторите пароль" {
									at Label { title "Повторите пароль"; pos 21 -17 }
									at Value { hidden yes }
								}
								item consents {
									auto-layout column; gap 8; padding 0 0 8 0; width 396; clip yes
									use Libraries.login_kit.LoginCheckbox as "Check Я даю Согласие на обрабо" {
										checked false
										at Label { title "Я даю Согласие на обработку персональных данных" }
									}
									use Libraries.login_kit.LoginCheckbox as "Check Я согласен с Лицензионны" {
										checked false
										at Label { title "Я согласен с Лицензионным договором, Пользовательским соглашением, Политикой конфиденциальности" }
									}
								}
								use Libraries.login_kit.LoginStatus as Status {
									at message.Message { title "Требуется заполнить Имя" }
								}
								use Libraries.login_kit.LoginButton as "Button Зарегистрироваться" { kind primary; disabled true }
							}
							item spacer { auto-layout abs; width 396; height 16; clip yes }
						}
					}
				}
			}
		}
		use Libraries.workbench.TopBar as "Top bar" {
			at limits { hidden yes }
			at icon_kit_Search { hidden yes }
			at icon_kit_Camera { hidden yes }
			at icon_recorder_dot { hidden yes }
			at icon_recorder_Rec { hidden yes }
			at tabs { hidden yes }
		}
	}
