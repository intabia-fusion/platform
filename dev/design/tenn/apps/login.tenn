		item Copyright {
			auto-layout row; gap 4; align center; clip yes; pos 28 -1045.5
			item "© 2026," { title "© 2026,"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #3c4149 }
			item "Интабия Фьюжн" { title "Интабия Фьюжн"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #333333 }
		}
		item "Card slot" {
			auto-layout row; align center; justify center; width 1920; height 1080
			use Libraries.login_kit.LoginCard as "Login card" {
				slot content {
					use Libraries.login_kit.LoginForm as "Login form" {
						padding 16 24
						slot content {
							use Libraries.login_kit.LoginOtpHeader as Header {
								at title_row.Enter_the_code { title "Введите код" }
								at description.We_sent_the_code_to { title "Мы отправили код на" }
								at description.name_example_com { title demo1 }
							}
							item body {
								auto-layout column; padding 24 0 0 0; width 412; clip yes
								use Libraries.login_kit.LoginCode as Code {
									at digit_1._1 { title "4" }
									at digit_2._2 { title "8" }
									at digit_3._3 { title "2" }
									at digit_4._4 { title "9" }
									at digit_5._5 { title "1" }
									at digit_6._6 { title "3" }
								}
							}
							item footer {
								auto-layout column; gap 4; padding 24 0 0 0; width 412; height 74; clip yes
								item "Не нашли код? Проверьте папку со спамом." {
									title "Не нашли код? Проверьте папку со спамом."; font-size 12.8; line-height 17; font-family "IBM Plex Sans"; layout left; text-color #00000066
								}
								item "Изменить email" { title "Изменить email"; font-size 12.8; line-height 17; font-family "IBM Plex Sans"; layout left; text-color #333333 }
							}
							item status { auto-layout abs; width 412; height 46; clip yes }
						}
					}
				}
			}
		}
		use Libraries.workbench.TopBar as "Top bar" {
			at limits { hidden yes }
			at icon_kit_Search { hidden yes }
			at icon_kit_Camera { hidden yes }
			at icon_recorder_dot { hidden yes }
			at icon_recorder_Rec { hidden yes }
			at tabs { hidden yes }
		}
	}
