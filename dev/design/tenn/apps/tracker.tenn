										item "3h" { title "3h"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000080 }
									}
									item divider {
										auto-layout row; padding 0 6 0 14; width 21; height 24; clip yes
										item line { auto-layout abs; width 1; height 24; clip yes; color #00000012 }
									}
									item "col created" {
										auto-layout row; align center; width 68; height 18; clip yes
										item created { title "5 days ago"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
									}
									item divider {
										auto-layout row; padding 0 6 0 14; width 21; height 24; clip yes
										item line { auto-layout abs; width 1; height 24; clip yes; color #00000012 }
									}
									item "col modified" {
										auto-layout row; align center; width 36; height 18; clip yes
										item modified { title "Oct 15"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
									}
									use Libraries.ui_kit.People.Avatar as "Avatar/24" {
										width 24; height 24; color #1467b3; corner-radius 5
										at initials { title WO; font-size 10; line-height 13 }
									}
								}
							}
						}
					}
					use Libraries.tracker_kit.IssueGroup as "Group Canceled" {
						at categoryHeader { color #dedee1 }
						replace categoryHeader.title.StatusIcon_active {
							item "StatusIcon/lost" {
								auto-layout abs; width 16; height 16
								item ring { width 14; height 14; corner-radius 7; border-color #939395; line-width 1.5; pos 1 -1 }
								item disc { width 14; height 14; corner-radius 7; color #939395; pos 1 -1 }
								item cross { width 16; height 16; path "M6 6L10 10M10 6L6 10"; view-box 0 0 16 16; border-color #ffffff; line-width 1.5 }
							}
						}
						at categoryHeader.title.In_Progress { title Canceled; text-color #79797c }
						at categoryHeader.estimation.estimation { title "0h"; text-color #79797c }
						slot rows {
							use Libraries.tracker_kit.IssueRow as "IssueRow APP-15" {
								width 1479
								at row { width 1479; height 44 }
								at border { hidden yes }
								slot row {
									item check { auto-layout row; width 16; height 16; clip yes; border-color #cf13a233; corner-radius 4 }
									item spacer { auto-layout abs; width 4; height 1; clip yes }
									item priority {
										auto-layout row; align center; width 16; height 16; clip yes
										use Libraries.ui_kit.Status.PriorityIcon as "Status/PriorityIcon/low" { priority low }
									}
									item id {
										auto-layout row; align center; width 49; height 18; clip yes
										item "APP-15" { title APP-15; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #00000080 }
									}
									item status {
										auto-layout row; padding 0 0 0 14; width 30; height 16; clip yes
										item "StatusIcon/lost" {
											auto-layout abs; width 16; height 16
											item ring { width 14; height 14; corner-radius 7; border-color #939395; line-width 1.5; pos 1 -1 }
											item disc { width 14; height 14; corner-radius 7; color #939395; pos 1 -1 }
											item cross { width 16; height 16; path "M6 6L10 10M10 6L6 10"; view-box 0 0 16 16; border-color #ffffff; line-width 1.5 }
										}
									}
									item title { title "Old support chat module"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; auto-layout row }
									item grow { auto-layout abs; width fill; height 1; clip yes }
									item divider {
										auto-layout row; padding 0 6 0 14; width 21; height 24; clip yes
										item line { auto-layout abs; width 1; height 24; clip yes; color #00000012 }
									}
									item "col reported" {
										auto-layout row; align center; width 16; height 18; clip yes
										item reported { title "0h"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000080 }
									}
									item divider {
										auto-layout row; padding 0 6 0 14; width 21; height 24; clip yes
										item line { auto-layout abs; width 1; height 24; clip yes; color #00000012 }
									}
									item estimation {
										auto-layout row; gap 8; align center; width 48; height 18; clip yes
										item spacer { auto-layout abs; width 16; height 16; clip yes }
										item "0h" { title "0h"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000080 }
									}
									item divider {
										auto-layout row; padding 0 6 0 14; width 21; height 24; clip yes
										item line { auto-layout abs; width 1; height 24; clip yes; color #00000012 }
									}
									item "col created" {
										auto-layout row; align center; width 68; height 18; clip yes
										item created { title "2 weeks ago"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
									}
									item divider {
										auto-layout row; padding 0 6 0 14; width 21; height 24; clip yes
										item line { auto-layout abs; width 1; height 24; clip yes; color #00000012 }
									}
									item "col modified" {
										auto-layout row; align center; width 36; height 18; clip yes
										item modified { title "Oct 9"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
									}
									use Libraries.ui_kit.People.Avatar as "Avatar/empty" { empty true; width 24; height 24; corner-radius 5 }
								}
							}
						}
					}
				}
			}
		}
		slot overlay {
			item Overlay { auto-layout abs; width 1920; height 1080; clip yes; color #00000033 }
			use Libraries.tracker_kit.NewIssuePopup as "New issue popup" {
				pos 594 -150
				at header.project.Mobile_app { title "Mobile App" }
				replace attributes.status.StatusIcon_backlog {
					item "StatusIcon/todo" {
						auto-layout abs; width 13; height 13
						item ring { width 11; height 11; corner-radius 5.5; border-color #758595; line-width 1.5; pos 1 -1 }
					}
				}
				at attributes.status.Backlog { title Todo }
			}
		}
	}
}
element "Project settings" {
	use Libraries.workbench.Workbench as "Настройки проекта - Основное" {
