		slot Main_panel {
			use Libraries.settings_kit.SettingsLayout as Settings {
				width 1515; height 1044
				at Settings_header { width 1515 }
				replace Settings_header.left.Button_ghost_small {
					use Libraries.ui_kit.Actions.Button as "Button/ghost/small" {
						kind ghost; size small
						replace icon_kit_Plus {
							use Libraries.ui_kit.Icon.chevronL as "icon/chevronL" { border-color #5a667e; line-width 1 }
						}
						at Button { title "К доске" }
					}
				}
				at Settings_header.left.Settings { title "Настройки доски" }
				at divider { width 1515 }
				at Settings_tabs { height 987 }
				at divider_2 { height 987 }
				at Settings_subtabs { hidden no; auto-layout column; gap 16; padding 24 32; align start; width 1282; height 987 }
				at Settings_content { hidden yes }
				slot right {
					use Libraries.ui_kit.Actions.Button as "Board in settings" {
						kind ghost; size small
						replace icon_kit_Plus {
							use Libraries.ui_kit.Icon.board as "icon/board" { border-color #5a667e; line-width 1 }
						}
						at Button { title "Основная доска" }
						at icon_chevronD { hidden no }
					}
					use Libraries.ui_kit.Actions.Button as "Close settings" {
						kind tertiary; size small; shape icon
						replace icon_gear {
							use Libraries.ui_kit.Icon.x as "icon/x" { border-color #5a667e; line-width 1 }
						}
					}
				}
				slot Settings_tabs {
					use Libraries.workbench.NavItem as "NavItem/Основное" {
						selected true; width 208
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.gear as "icon/gear" { border-color #cf13a2; line-width 1 }
						}
						at Issues { title Основное }
					}
					use Libraries.workbench.NavItem as "NavItem/Колонки" {
						width 208
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.board as "icon/board" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Колонки }
					}
					use Libraries.workbench.NavItem as "NavItem/Дорожки" {
						width 208
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.timeline as "icon/timeline" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Дорожки }
					}
					use Libraries.workbench.NavItem as "NavItem/Быстрые фильтры" {
						width 208
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.star as "icon/star" { border-color #0f121a; line-width 1 }
						}
						at Issues { title "Быстрые фильтры" }
					}
					use Libraries.workbench.NavItem as "NavItem/Цвета карточек" {
						width 208
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.milestone as "icon/milestone" { border-color #0f121a; line-width 1 }
						}
						at Issues { title "Цвета карточек" }
					}
					use Libraries.workbench.NavItem as "NavItem/Карточка" {
						width 208
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.check as "icon/check" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Карточка }
					}
				}
				slot Settings_subtabs {
					use Libraries.settings_kit.SectionTitle as "Section Основное" {
						at Title { title Основное }
						at Hint_of_the_section { hidden no; title "Какие задачи попадают на доску и кто может её менять."; width 720 }
					}
					use Libraries.settings_kit.FormRow as "Row Название" {
						at label.Label { title Название }
						slot control {
							use Libraries.ui_kit.Forms.Input as Input {
								at field { width 420 }
								at field.Value { title "Основная доска" }
							}
						}
					}
					use Libraries.settings_kit.FormRow as "Row Проекты" {
						at label.Label { title Проекты }
						at label.Hint { hidden no; title "Задачи из нескольких проектов на одной доске" }
						slot control {
							item projects {
								auto-layout row; gap 6; align center; clip yes
								use Libraries.ui_kit.TagsAndFilters.Chip as Chip {
									slot content {
										use Libraries.ui_kit.Icon.board as "icon/board" { width 14; height 14; border-color #00000099; line-width 1.14 }
										item "Мобильное приложение · APP" {
											title "Мобильное приложение · APP"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; auto-layout row
										}
									}
								}
								use Libraries.ui_kit.TagsAndFilters.Chip as Chip {
									slot content {
										use Libraries.ui_kit.Icon.board as "icon/board" { width 14; height 14; border-color #00000099; line-width 1.14 }
										item "Маркетинг · MKT" { title "Маркетинг · MKT"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; auto-layout row }
									}
								}
								use Libraries.ui_kit.Actions.Button as "Button/tertiary/extra-small" {
									kind tertiary; size extra-small
									replace icon_kit_Plus {
										use Libraries.ui_kit.Icon.plus as "icon/plus" { border-color #6b3ad3; line-width 1 }
									}
									at Button { title Добавить }
								}
							}
						}
					}
					use Libraries.settings_kit.FormRow as "Row Фильтр доски" {
						align start
						at label.Label { title "Фильтр доски" }
						at label.Hint { hidden no; title "Условия объединяются через «И», как в фильтре списка задач" }
						slot control {
							item "filter block" {
								auto-layout column; gap 8; clip yes
								item filters {
									auto-layout row; gap 6; width 480; clip yes; wrap yes; line-gap 6
									use Libraries.ui_kit.TagsAndFilters.FilterChip as "FilterChip/Приоритет" {
										at part.Priority { title Приоритет }
										at part_2.in { title из }
										at part_3.Urgent__High { title "Urgent, High, Medium, Low" }
									}
									use Libraries.ui_kit.TagsAndFilters.FilterChip as "FilterChip/Статус" {
										at part.Priority { title Статус }
										at part_2.in { title не }
										at part_3.Urgent__High { title Archived }
									}
									use Libraries.ui_kit.Actions.Button as "Button/ghost/extra-small" {
										kind ghost; size extra-small
										replace icon_kit_Plus {
											use Libraries.ui_kit.Icon.plus as "icon/plus" { border-color #5a667e; line-width 1 }
										}
										at Button { title Условие }
									}
								}
								item "Под фильтр попадает 40 из 41 задачи прое" {
									title "Под фильтр попадает 40 из 41 задачи проектов доски. Остальные на доске не видны."; font-size 12; line-height 15; font-family "IBM Plex Sans"
									layout left; text-color #00000066
								}
							}
						}
					}
					use Libraries.settings_kit.FormRow as "Row Скрывать выполненные старше" {
						at label.Label { title "Скрывать выполненные старше" }
						at label.Hint { hidden no; title "Колонки категории «Выполнено»" }
						slot control {
							use Libraries.ui_kit.Forms.Input as Input {
								at field { width 200 }
								at field.Value { title "2 недели" }
								at field.grow { hidden no }
								at field.icon_chevronD { hidden no }
							}
						}
					}
					use Libraries.settings_kit.FormRow as "Row Порядок карточек" {
						at label.Label { title "Порядок карточек" }
						slot control {
							use Libraries.ui_kit.Forms.Input as Input {
								at field { width 200 }
								at field.Value { title "Ручной порядок" }
								at field.grow { hidden no }
								at field.icon_chevronD { hidden no }
							}
						}
					}
					item divider { auto-layout abs; width 720; height 1; clip yes; color #0000000f }
					use Libraries.settings_kit.FormRow as "Row Видимость" {
						align start
						at label.Label { title Видимость }
						slot control {
							item vis {
								auto-layout column; gap 10; clip yes
								use Libraries.ui_kit.Forms.Radio as "Radio Все участники проекта" {
									at text.Label { title "Все участники проекта" }
								}
								use Libraries.ui_kit.Forms.Radio as "Radio Только я" {
									on false
									at text.Label { title "Только я" }
									at text.Hint { hidden no; title "Личная доска, видна в «Мои доски»" }
								}
							}
						}
					}
					use Libraries.settings_kit.FormRow as "Row Автор" {
						at label.Label { title Автор }
						at label.Hint { hidden no; title "Может менять настройки доски" }
						slot control {
							item author {
								auto-layout row; gap 6; align center; clip yes
								use Libraries.ui_kit.People.Avatar as "Avatar/24" {
									width 24; height 24; color #4ca6ee; corner-radius 5
									at initials { title СА; font-size 10; line-height 13 }
								}
								item "Анна Смирнова" { title "Анна Смирнова"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
							}
						}
					}
					use Libraries.settings_kit.FormRow as "Row Могут править" {
						at label.Label { title "Могут править" }
						at label.Hint { hidden no; title "Остальные могут пользоваться доской или создать свою" }
						slot control {
							item editors {
								auto-layout row; gap 12; align center; clip yes
								item editor {
									auto-layout row; gap 6; align center; clip yes
									use Libraries.ui_kit.People.Avatar as "Avatar/24" {
										width 24; height 24; color #83af12; corner-radius 5
										at initials { title КМ; font-size 10; line-height 13 }
									}
									item "Мария Козлова" { title "Мария Козлова"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
								}
								item editor {
									auto-layout row; gap 6; align center; clip yes
									use Libraries.ui_kit.People.Avatar as "Avatar/24" {
										width 24; height 24; color #db877d; corner-radius 5
										at initials { title ПИ; font-size 10; line-height 13 }
									}
									item "Иван Петров" { title "Иван Петров"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
								}
								use Libraries.ui_kit.Actions.Button as "Button/tertiary/extra-small" {
									kind tertiary; size extra-small
									replace icon_kit_Plus {
										use Libraries.ui_kit.Icon.plus as "icon/plus" { border-color #6b3ad3; line-width 1 }
									}
									at Button { title Добавить }
								}
							}
						}
					}
				}
			}
		}
	}
