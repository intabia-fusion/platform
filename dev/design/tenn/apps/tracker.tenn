										width 16; height 16
										path "M8.00 1.00A7 7 0 0 1 8.55 1.02M12.11 2.34A7 7 0 0 1 12.55 2.68M14.66 5.84A7 7 0 0 1 14.81 6.37M14.66 10.16A7 7 0 0 1 14.46 10.68M12.11 13.66A7 7 0 0 1 11.65 13.97M8.00 15.00A7 7 0 0 1 7.45 14.98M3.89 13.66A7 7 0 0 1 3.45 13.32M1.34 10.16A7 7 0 0 1 1.19 9.63M1.34 5.84A7 7 0 0 1 1.54 5.32M3.89 2.34A7 7 0 0 1 4.35 2.03"
										view-box 0 0 16 16; border-color #a1a1a1; line-width 1.5
									}
