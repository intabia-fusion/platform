entry "../../../PlatformDesign.tenn"

item Root {
  auto-layout column; width 1520; padding 40; gap 28; color #f7f7fa; corner-radius 16; font-family "IBM Plex Sans"
  item Header {
    auto-layout row; width fill; align center
    item Title { title "После кода: профиль и первое пространство - два варианта"; width fill; font-size 22; font-weight 600; line-height 28; text-color #201240; layout left }
    item Num { title "Сравнение 5 из 6"; font-size 12; line-height 16; text-color #7f7f7f }
  }
  item Columns {
    auto-layout row; gap 32; width fill; align start
    item Variant_A {
      auto-layout column; gap 12; width 460
      item Label {
        auto-layout row; padding 4 10; color #efdcf2; corner-radius 6
        item Text { title "ВАРИАНТ A: ОДНА ФОРМА"; font-size 11; font-weight 600; text-color #7d1f70 }
      }
      use Libraries.login_kit.LoginCard as Card_A {
        slot content {
          use Libraries.login_kit.LoginForm as Form_A {
            slot content {
              item form_a {
                auto-layout column; gap 16; width 396
                item Heading_A {
                  auto-layout column; gap 8; width 396; align center
                  item Title_A { title "Профиль и пространство"; font-size 28; font-weight 700; line-height 36; text-color #000061 }
                  item "email row A" {
                    auto-layout row; gap 8; align center; justify center; width 396
                    item Email_A { title "anna.smirnova@intabia.io"; font-size 14; line-height 18; text-color #000061 }
                    item Change_A { title "Сменить"; font-size 14; line-height 18; text-color #6e48ce }
                  }
                }
                use Libraries.login_kit.LoginField as "Field A Имя" { label Имя; at Value { title Анна } }
                use Libraries.login_kit.LoginField as "Field A Фамилия" { label Фамилия; at Value { title Смирнова } }
                use Libraries.login_kit.LoginField as "Field A Телефон" { label "Телефон · необязательно"; at Value { hidden yes } }
                use Libraries.login_kit.LoginField as "Field A Пространство" { label "Название пространства"; at Value { title "Команда Анны" } }
                use Libraries.login_kit.LoginCheckbox as "Check A Согласие" {
                  checked true; label "Соглашаюсь с Условиями использования и обработкой персональных данных"
                }
                use Libraries.login_kit.LoginButton as "Button A Создать" { at Button { title "Создать аккаунт и войти" } }
              }
            }
          }
        }
      }
      item Note_A {
        auto-layout column; gap 6; width fill; padding 12; color #ffffff; border-color #d9b9d8; corner-radius 10
        item NTitle_A { title "Плюсы и минусы A"; font-size 12; font-weight 600; text-color #7d1f70; layout left }
        item NText_A { title "Плюс: один шаг до рабочего пространства. Минус: форма длинная - четыре поля в один экран; пространство начинает создаваться только после нажатия, до рабочего экрана ждём дольше."; width fill; font-size 13; line-height 18; text-color #5c6470; layout left }
      }
    }
    item Variant_B {
      auto-layout column; gap 12; width 460
      item Label {
        auto-layout row; padding 4 10; color #efdcf2; corner-radius 6
        item Text { title "ВАРИАНТ B: ПРОСТРАНСТВО В ФОНЕ"; font-size 11; font-weight 600; text-color #7d1f70 }
      }
      use Libraries.login_kit.LoginCard as Card_B1 {
        slot content {
          use Libraries.login_kit.LoginForm as Form_B1 {
            slot content {
              item form_b1 {
                auto-layout column; gap 20; width 396
                item Heading_B1 {
                  auto-layout column; gap 8; width 396; align center
                  item Title_B1 { title "Сначала пространство"; font-size 28; font-weight 700; line-height 36; text-color #000061 }
                  item Subtitle_B1 { title "Назовите его - создадим, пока вы заполняете профиль"; width fill; font-size 14; line-height 18; text-color #5c6470; layout left }
                }
                use Libraries.login_kit.LoginField as "Field B Название" { label "Название пространства"; at Value { title "Команда Анны" } }
                use Libraries.login_kit.LoginButton as "Button B Продолжить" { at Button { title "Создать и продолжить" } }
              }
            }
          }
        }
      }
      use Libraries.login_kit.LoginCard as Card_B2 {
        slot content {
          use Libraries.login_kit.LoginForm as Form_B2 {
            slot content {
              item form_b2 {
                auto-layout column; gap 16; width 396
                item Heading_B2 {
                  auto-layout column; gap 8; width 396; align center
                  item Title_B2 { title "Ваш профиль"; font-size 28; font-weight 700; line-height 36; text-color #000061 }
                  item Subtitle_B2 { title "Пространство создаётся, пока вы заполняете форму"; width fill; font-size 14; line-height 18; text-color #5c6470; layout left }
                }
                use Libraries.login_kit.LoginStatus as "Progress B2" {
                  at message.Message { title "Создаём «Команда Анны»…" }
                }
                use Libraries.login_kit.LoginField as "Field B2 Имя" { label Имя; at Value { title Анна } }
                use Libraries.login_kit.LoginField as "Field B2 Фамилия" { label Фамилия; at Value { title Смирнова } }
                use Libraries.login_kit.LoginField as "Field B2 Телефон" { label "Телефон · необязательно"; at Value { hidden yes } }
                use Libraries.login_kit.LoginCheckbox as "Check B2 Согласие" {
                  checked true; label "Соглашаюсь с Условиями использования и обработкой персональных данных"
                }
                use Libraries.login_kit.LoginButton as "Button B2 Сохранить" { at Button { title "Сохранить и войти" } }
              }
            }
          }
        }
      }
      use Libraries.login_kit.LoginCard as Card_B3 {
        slot content {
          use Libraries.login_kit.LoginForm as Form_B3 {
            slot content {
              item form_b3 {
                auto-layout column; gap 16; width 396
                item Heading_B3 {
                  auto-layout column; gap 8; width 396; align center
                  item Title_B3 { title "Ваш профиль"; font-size 28; font-weight 700; line-height 36; text-color #000061 }
                  item Subtitle_B3 { title "Пространство не создано - вы ничего не потеряли"; width fill; font-size 14; line-height 18; text-color #5c6470; layout left }
                }
                use Libraries.login_kit.LoginStatus as "Error B3" {
                  kind error
                  at message.Message { title "Не удалось создать «Команда Анны». Профиль сохранён." }
                }
                use Libraries.login_kit.LoginField as "Field B3 Имя" { label Имя; at Value { title Анна } }
                use Libraries.login_kit.LoginField as "Field B3 Фамилия" { label Фамилия; at Value { title Смирнова } }
                use Libraries.login_kit.LoginField as "Field B3 Телефон" { label "Телефон · необязательно"; at Value { hidden yes } }
                item "error actions" {
                  auto-layout row; gap 8; width 396
                  use Libraries.login_kit.LoginButton as "Button B3 Повторить" {
                    width 190
                    at Button { title "Повторить" }
                  }
                  use Libraries.login_kit.LoginButton as "Button B3 Войти" {
                    kind default; width 190
                    at Button { title "Войти и создать позже" }
                  }
                }
              }
            }
          }
        }
      }
      item Note_B {
        auto-layout column; gap 6; width fill; padding 12; color #ffffff; border-color #d9b9d8; corner-radius 10
        item NTitle_B { title "Плюсы и минусы B"; font-size 12; font-weight 600; text-color #7d1f70; layout left }
        item NText_B { title "Плюс: к моменту сохранения профиля пространство уже создано - быстрее до рабочего экрана. Минус: два шага и обработка ошибки фоновой операции. Ошибка не тупик: профиль сохранён, пространство можно повторить или создать позже."; width fill; font-size 13; line-height 18; text-color #5c6470; layout left }
      }
    }
  }
  item Note_Phone {
    auto-layout column; gap 6; width fill; padding 12; color #ffffff; border-color #00000014; corner-radius 10
    item NTitle_Phone { title "Телефон в обоих вариантах"; font-size 12; font-weight 600; text-color #5c6470; layout left }
    item NText_Phone { title "Поле необязательно - помечено в подписи. Вариант совсем без телефона: убрать поле, форма короче на одно поле, но канал уведомлений и восстановления остаётся только email. Решение - за продуктом."; width fill; font-size 13; line-height 18; text-color #5c6470; layout left }
  }
}