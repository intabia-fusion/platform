entry "../../../PlatformDesign.tenn"

item Root {
    auto-layout column; width 1520; padding 40; gap 28; color #f7f7fa; corner-radius 16; font-family "IBM Plex Sans"
    item Header {
      auto-layout row; width fill; align center
      item Title { title "Регистрация: шесть полей против двух"; width fill; font-size 22; font-weight 600; line-height 28; text-color #201240; layout left }
      item Num { title "Сравнение 2 из 6"; font-size 12; line-height 16; text-color #7f7f7f }
    }
    item Columns {
      auto-layout row; gap 32; width fill; align start
      item Current {
        auto-layout column; gap 12; width 460
        item Label {
          auto-layout row; padding 4 10; color #ffffff; border-color #00000014; corner-radius 6
          item Text { title "СЕЙЧАС"; font-size 11; font-weight 600; text-color #5c6470 }
        }
        use Libraries.login_kit.LoginCard as Card {
          slot content {
            use Libraries.login_kit.LoginForm as Form {
              slot content {
                item form {
                  auto-layout column; gap 16; width 396
                  use Libraries.login_kit.LoginTabs as Tabs {
                    at heading.Platform { title "Интабия Платформа" }
                    at tabs.Tab_Sign_up.Sign_up { title Регистрация; font-weight 600 }
                    at tabs.Tab_Sign_up.underline { color #cf13a2 }
                    at tabs.Tab_Log_In.Log_In { title Вход; font-weight 500 }
                  }
                  use Libraries.login_kit.LoginField as "Field Имя" { label Имя; at Value { hidden yes } }
                  use Libraries.login_kit.LoginField as "Field Фамилия" { label Фамилия; at Value { hidden yes } }
                  use Libraries.login_kit.LoginField as "Field Email" { label Email; at Value { hidden yes } }
                  use Libraries.login_kit.LoginField as "Field Телефон" { label "Номер телефона"; at Value { hidden yes } }
                  use Libraries.login_kit.LoginField as "Field Пароль" { label Пароль; at Value { hidden yes } }
                  use Libraries.login_kit.LoginField as "Field Повтор" { label "Повторите пароль"; at Value { hidden yes } }
                  use Libraries.login_kit.LoginCheckbox as "Check Персональные" {
                    checked false; label "Я даю Согласие на обработку персональных данных"
                  }
                  use Libraries.login_kit.LoginCheckbox as "Check Условия" {
                    checked false; label "Я согласен с Лицензионным договором, Пользовательским соглашением, Политикой конфиденциальности"
                  }
                  use Libraries.login_kit.LoginStatus as Status {
                    at message.Message { title "Требуется заполнить Имя" }
                  }
                  use Libraries.login_kit.LoginButton as "Button Зарегистрироваться" {
                    disabled true
                    at Button { title "Зарегистрироваться" }
                  }
                }
              }
            }
          }
        }
        item Problem {
          auto-layout column; gap 6; width fill; padding 12; color #ffffff; border-color #ee7a7a66; corner-radius 10
          item PTitle { title "Проблема"; font-size 12; font-weight 600; text-color #c14b4b; layout left }
          item PText { title "Проверено на стенде sanity (конфигурация с паролем, OTP выключен): шесть полей, два согласия не отмечены, кнопка заблокирована до заполнения. Email спрашивают заново - на старте его уже вводили в другом табе."; width fill; font-size 13; line-height 18; text-color #5c6470; layout left }
        }
      }
      item Proposed {
        auto-layout column; gap 12; width 460
        item Label {
          auto-layout row; padding 4 10; color #efdcf2; corner-radius 6
          item Text { title "ПРЕДЛОЖЕНИЕ"; font-size 11; font-weight 600; text-color #7d1f70 }
        }
        use Libraries.login_kit.LoginCard as Card {
          slot content {
            use Libraries.login_kit.LoginForm as Form {
              slot content {
                item form {
                  auto-layout column; gap 20; width 396
                  item Heading {
                    auto-layout column; gap 8; width 396; align center
                    item Title { title "Создание аккаунта"; font-size 28; font-weight 700; line-height 36; text-color #000061 }
                    item "email row" {
                      auto-layout row; gap 8; align center; justify center; width 396
                      item Email { title "anna.smirnova@intabia.io"; font-size 14; line-height 18; text-color #000061 }
                      item Change { title "Сменить"; font-size 14; line-height 18; text-color #6e48ce }
                    }
                  }
                  use Libraries.login_kit.LoginField as "Field Имя" { label Имя; at Value { title Анна } }
                  use Libraries.login_kit.LoginField as "Field Фамилия" { label Фамилия; at Value { title Смирнова } }
                  use Libraries.login_kit.LoginField as "Field Телефон" {
                    label "Телефон · необязательно"
                    at Value { hidden yes }
                  }
                  use Libraries.login_kit.LoginCheckbox as "Option Согласие" {
                    checked true; label "Соглашаюсь с Условиями использования и обработкой персональных данных"
                  }
                  use Libraries.login_kit.LoginButton as "Button Создать" { at Button { title "Создать аккаунт" } }
                }
              }
            }
          }
        }
        item Change {
          auto-layout column; gap 6; width fill; padding 12; color #ffffff; border-color #d9b9d8; corner-radius 10
          item CTitle { title "Что меняется"; font-size 12; font-weight 600; text-color #7d1f70; layout left }
          item CText { title "После кода из письма: два обязательных поля вместо шести, телефон необязателен, пароль не нужен вовсе. Имя пространства - следующим шагом (варианты A/B - сравнение 5). Одно согласие вместо двух."; width fill; font-size 13; line-height 18; text-color #5c6470; layout left }
        }
      }
    }
}