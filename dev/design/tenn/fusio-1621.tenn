									use Libraries.ui_kit.Actions.Button as "IconButton/more" {
										kind tertiary; size extra-small; shape icon
										replace icon_gear {
											use Libraries.ui_kit.Icon.more as "icon/more" { border-color #5a667e; line-width 1 }
										}
									}
								}
							}
