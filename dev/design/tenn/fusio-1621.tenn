		slot Side_panel {
			item "Chat header" {
				auto-layout row; padding 0 16; align center; justify space-between; width 400; height 56; clip yes
				item title {
					auto-layout row; gap 8; align center; clip yes
					use Libraries.ui_kit.Icon.kit_Bubble as "icon/kit/Bubble" { color #000000 }
					item "Чат · Мобильное приложение" {
						title "Чат · Мобильное приложение"; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left
					}
				}
				use Libraries.ui_kit.Actions.Button as "Close chat" {
					kind tertiary; size small; shape icon
					replace icon_gear {
						use Libraries.ui_kit.Icon.x as "icon/x" { border-color #5a667e; line-width 1 }
					}
				}
			}
			item divider { auto-layout abs; width 400; height 1; clip yes; color #0000000f; pos 0 -56 }
			item Messages {
				auto-layout column; gap 16; padding 16; width 400; clip yes; pos 0 -57
				item message {
					auto-layout row; gap 10; width 368; clip yes
					use Libraries.ui_kit.People.Avatar as "Avatar/32" {
						width 32; height 32; color #4ca6ee; corner-radius 6
						at initials { title СА; font-size 13; line-height 16 }
					}
					item body {
						auto-layout column; gap 2; clip yes
						item author {
							auto-layout row; gap 8; align center; clip yes
							item "Анна Смирнова" { title "Анна Смирнова"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left }
							item "10:12" { title "10:12"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
						}
						item "Поменял исполнителя по умолчанию, провер" {
							title "Поменял исполнителя по умолчанию, проверьте."; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; width 322
						}
					}
				}
				item message {
					auto-layout row; gap 10; width 368; clip yes
					use Libraries.ui_kit.People.Avatar as "Avatar/32" {
						width 32; height 32; color #83af12; corner-radius 6
						at initials { title КМ; font-size 13; line-height 16 }
					}
					item body {
						auto-layout column; gap 2; clip yes
						item author {
							auto-layout row; gap 8; align center; clip yes
							item "Мария Козлова" { title "Мария Козлова"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left }
							item "10:15" { title "10:15"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
						}
						item "Ок. Статус по умолчанию оставляем Backlo" {
							title "Ок. Статус по умолчанию оставляем Backlog?"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; width 322
						}
					}
				}
				item message {
					auto-layout row; gap 10; width 368; clip yes
					use Libraries.ui_kit.People.Avatar as "Avatar/32" {
						width 32; height 32; color #db877d; corner-radius 6
						at initials { title ПИ; font-size 13; line-height 16 }
					}
					item body {
						auto-layout column; gap 2; clip yes
						item author {
							auto-layout row; gap 8; align center; clip yes
							item "Иван Петров" { title "Иван Петров"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left }
							item "10:18" { title "10:18"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
						}
						item "Да, Backlog. Шаблоны задач допишу позже." {
							title "Да, Backlog. Шаблоны задач допишу позже."; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; width 322
						}
					}
				}
			}
			item "Message input" {
				auto-layout row; padding 0 12; align center; width 368; height 44; clip yes; color #1530720d; border-color #1530720d; corner-radius 8; pos 16 -984
				item "Написать сообщение" { title "Написать сообщение"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #556178 }
			}
