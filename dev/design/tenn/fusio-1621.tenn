entry "../../../PlatformDesign.tenn"
element "1 Настройки проекта" {
	use Libraries.workbench.Workbench as "Настройки проекта - Основное" {
		pos 0 0
		replace Top_bar {
			use Libraries.workbench.TopBar as "Top bar" {
				at tabs.tab.Tracker { title "Настройки проекта" }
			}
		}
		replace _Navigator {
			use Libraries.workbench.Navigator as Navigator {
				pos 68 -36
				slot items {
					use Libraries.workbench.NavItem as "NavItem/My issues" {
						pos 13 -112
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.timeline as "icon/timeline" { border-color #0f121a; line-width 1 }
						}
						at Issues { title "My issues" }
					}
					use Libraries.workbench.NavItem as "NavItem/All issues" {
						pos 13 -144
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.check as "icon/check" { border-color #0f121a; line-width 1 }
						}
						at Issues { title "All issues" }
					}
					use Libraries.workbench.NavItem as "NavItem/Доски" {
						pos 13 -176
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.board as "icon/board" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Доски }
					}
					use Libraries.workbench.NavItem as "NavItem/Тестирование" {
						padding 0 8 0 32; pos 13 -208
						at icon_kit_CheckSquare { hidden yes }
						at Issues { title Тестирование }
					}
					use Libraries.workbench.NavItem as "NavItem/Мой спринт" {
						padding 0 8 0 32; pos 13 -240
						at icon_kit_CheckSquare { hidden yes }
						at Issues { title "Мой спринт" }
					}
					item divider { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -284 }
					use Libraries.workbench.NavGroup as "NavGroup Your projects" { pos 0 -284 }
					use Libraries.workbench.NavSpace as "NavSpace Мобильное приложение" {
						pos 0 -329
						at label.Mobile_app { title "МОБИЛЬНОЕ ПРИЛОЖЕНИЕ" }
					}
					use Libraries.workbench.NavItem as "NavItem/Issues" {
						padding 0 8 0 32; pos 13 -365
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.check as "icon/check" { border-color #0f121a; line-width 1 }
						}
					}
					use Libraries.workbench.NavItem as "NavItem/Components" {
						padding 0 8 0 32; pos 13 -397
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.component as "icon/component" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Components }
					}
					use Libraries.workbench.NavItem as "NavItem/Milestones" {
						padding 0 8 0 32; pos 13 -429
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.milestone as "icon/milestone" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Milestones }
					}
					use Libraries.workbench.NavSpace as "NavSpace Маркетинг" {
						pos 0 -457
						at label.Mobile_app { title МАРКЕТИНГ }
					}
					use Libraries.workbench.NavItem as "NavItem/Issues" {
						padding 0 8 0 32; pos 13 -493
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.check as "icon/check" { border-color #0f121a; line-width 1 }
						}
					}
					use Libraries.workbench.NavItem as "NavItem/Components" {
						padding 0 8 0 32; pos 13 -525
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.component as "icon/component" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Components }
					}
					use Libraries.workbench.NavItem as "NavItem/Milestones" {
						padding 0 8 0 32; pos 13 -557
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.milestone as "icon/milestone" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Milestones }
					}
					item "footer line" { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -597 }
				}
			}
		}
		slot Main_panel {
			use Libraries.settings_kit.SettingsLayout as Settings {
				width 1515; height 1044
				at Settings_header { width 1515 }
				replace Settings_header.left.Button_ghost_small {
					use Libraries.ui_kit.Actions.Button as "Button/ghost/small" {
						kind ghost; size small
						replace icon_kit_Plus {
							use Libraries.ui_kit.Icon.chevronL as "icon/chevronL" { border-color #5a667e; line-width 1 }
						}
						at Button { title "К проекту" }
					}
				}
				at Settings_header.left.Settings { title "Настройки проекта" }
				at divider { width 1515 }
				at Settings_tabs { height 987 }
				at divider_2 { height 987 }
				at Settings_subtabs { hidden no; auto-layout column; gap 16; padding 24 32; align start; width 1282; height 987 }
				at Settings_content { hidden yes }
				slot right {
					use Libraries.ui_kit.Actions.Button as "Close settings" {
						kind tertiary; size small; shape icon
						replace icon_gear {
							use Libraries.ui_kit.Icon.x as "icon/x" { border-color #5a667e; line-width 1 }
						}
					}
				}
				slot Settings_tabs {
					use Libraries.workbench.NavItem as "NavItem/Основное" {
						selected true; width 208
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.gear as "icon/gear" { border-color #cf13a2; line-width 1 }
						}
						at Issues { title Основное }
					}
					use Libraries.workbench.NavItem as "NavItem/Участники и доступ" {
						width 208
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.users as "icon/users" { border-color #0f121a; line-width 1 }
						}
						at Issues { title "Участники и доступ" }
					}
					use Libraries.workbench.NavItem as "NavItem/Задачи" {
						width 208
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.check as "icon/check" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Задачи }
					}
					use Libraries.workbench.NavItem as "NavItem/Статусы и workflow" {
						width 208
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.timeline as "icon/timeline" { border-color #0f121a; line-width 1 }
						}
						at Issues { title "Статусы и workflow" }
					}
					use Libraries.workbench.NavItem as "NavItem/Архив" {
						width 208
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.trash as "icon/trash" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Архив }
					}
				}
				slot Settings_subtabs {
					use Libraries.settings_kit.SectionTitle as "Section Основное" {
						at Title { title Основное }
						at Hint_of_the_section { hidden no; title "Изменения сохраняются сразу."; width 720 }
					}
					use Libraries.settings_kit.FormRow as "Row Тип проекта" {
						at label.Label { title "Тип проекта" }
						at label.Hint { hidden no; title "Статусы и типы задач берутся из типа" }
						slot control {
							item type {
								auto-layout row; gap 8; align center; clip yes
								use Libraries.ui_kit.TagsAndFilters.Chip as Chip {
									slot content {
										use Libraries.ui_kit.Status.StatusIcon as "Status/StatusIcon/backlog" { category backlog }
										item Default { title Default; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; auto-layout row; text-color #00000099 }
									}
								}
								use Libraries.ui_kit.Actions.Button as "Button/tertiary/extra-small" {
									kind tertiary; size extra-small
									at icon_kit_Plus { hidden yes }
									at Button { title "Открыть тип проекта" }
								}
							}
						}
					}
					use Libraries.settings_kit.FormRow as "Row Название" {
						at label.Label { title Название }
						slot control {
							use Libraries.ui_kit.Forms.Input as Input {
								at field { width 420 }
								at field.Value { title "Мобильное приложение" }
							}
						}
					}
					use Libraries.settings_kit.FormRow as "Row Идентификатор" {
						at label.Label { title Идентификатор }
						at label.Hint { hidden no; title "Префикс номеров задач: APP-6" }
						slot control {
							use Libraries.ui_kit.Forms.Input as Input {
								at field { width 160 }
								at field.Value { title APP }
							}
						}
					}
					use Libraries.settings_kit.FormRow as "Row Описание" {
						at label.Label { title Описание }
						slot control {
							use Libraries.ui_kit.Forms.Input as Input {
								layout multiline
								at field { width 420 }
								at field.icon_kit_PersonCircle { width 400 }
							}
						}
					}
					use Libraries.settings_kit.FormRow as "Row Иконка" {
						at label.Label { title Иконка }
						slot control {
							item icons {
								auto-layout row; gap 6; align center; clip yes
								item icon {
									auto-layout row; align center; justify center; width 32; height 32; clip yes; color #f0f0f0; border-color #cf13a2; corner-radius 6
									use Libraries.ui_kit.Icon.board as "icon/board" { border-color #00000099; line-width 1 }
								}
								item icon {
									auto-layout row; align center; justify center; width 32; height 32; clip yes; border-color #00000017; corner-radius 6
									use Libraries.ui_kit.Icon.star as "icon/star" { border-color #00000099; line-width 1 }
								}
								item icon {
									auto-layout row; align center; justify center; width 32; height 32; clip yes; border-color #00000017; corner-radius 6
									use Libraries.ui_kit.Icon.component as "icon/component" { border-color #00000099; line-width 1 }
								}
								item icon {
									auto-layout row; align center; justify center; width 32; height 32; clip yes; border-color #00000017; corner-radius 6
									use Libraries.ui_kit.Icon.milestone as "icon/milestone" { border-color #00000099; line-width 1 }
								}
								item icon {
									auto-layout row; align center; justify center; width 32; height 32; clip yes; border-color #00000017; corner-radius 6
									use Libraries.ui_kit.Icon.users as "icon/users" { border-color #00000099; line-width 1 }
								}
							}
						}
					}
				}
			}
		}
	}
	use Libraries.workbench.Workbench as "Настройки проекта - Участники и доступ" {
		pos 2020 0
		replace Top_bar {
			use Libraries.workbench.TopBar as "Top bar" {
				at tabs.tab.Tracker { title "Настройки проекта" }
			}
		}
		replace _Navigator {
			use Libraries.workbench.Navigator as Navigator {
				pos 68 -36
				slot items {
					use Libraries.workbench.NavItem as "NavItem/My issues" {
						pos 13 -112
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.timeline as "icon/timeline" { border-color #0f121a; line-width 1 }
						}
						at Issues { title "My issues" }
					}
					use Libraries.workbench.NavItem as "NavItem/All issues" {
						pos 13 -144
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.check as "icon/check" { border-color #0f121a; line-width 1 }
						}
						at Issues { title "All issues" }
					}
					use Libraries.workbench.NavItem as "NavItem/Доски" {
						pos 13 -176
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.board as "icon/board" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Доски }
					}
					use Libraries.workbench.NavItem as "NavItem/Тестирование" {
						padding 0 8 0 32; pos 13 -208
						at icon_kit_CheckSquare { hidden yes }
						at Issues { title Тестирование }
					}
					use Libraries.workbench.NavItem as "NavItem/Мой спринт" {
						padding 0 8 0 32; pos 13 -240
						at icon_kit_CheckSquare { hidden yes }
						at Issues { title "Мой спринт" }
					}
					item divider { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -284 }
					use Libraries.workbench.NavGroup as "NavGroup Your projects" { pos 0 -284 }
					use Libraries.workbench.NavSpace as "NavSpace Мобильное приложение" {
						pos 0 -329
						at label.Mobile_app { title "МОБИЛЬНОЕ ПРИЛОЖЕНИЕ" }
					}
					use Libraries.workbench.NavItem as "NavItem/Issues" {
						padding 0 8 0 32; pos 13 -365
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.check as "icon/check" { border-color #0f121a; line-width 1 }
						}
					}
					use Libraries.workbench.NavItem as "NavItem/Components" {
						padding 0 8 0 32; pos 13 -397
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.component as "icon/component" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Components }
					}
					use Libraries.workbench.NavItem as "NavItem/Milestones" {
						padding 0 8 0 32; pos 13 -429
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.milestone as "icon/milestone" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Milestones }
					}
					use Libraries.workbench.NavSpace as "NavSpace Маркетинг" {
						pos 0 -457
						at label.Mobile_app { title МАРКЕТИНГ }
					}
					use Libraries.workbench.NavItem as "NavItem/Issues" {
						padding 0 8 0 32; pos 13 -493
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.check as "icon/check" { border-color #0f121a; line-width 1 }
						}
					}
					use Libraries.workbench.NavItem as "NavItem/Components" {
						padding 0 8 0 32; pos 13 -525
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.component as "icon/component" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Components }
					}
					use Libraries.workbench.NavItem as "NavItem/Milestones" {
						padding 0 8 0 32; pos 13 -557
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.milestone as "icon/milestone" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Milestones }
					}
					item "footer line" { auto-layout abs; width 279; height 1; clip yes; color #0000001a; pos 1 -597 }
				}
			}
		}
		slot Main_panel {
			use Libraries.settings_kit.SettingsLayout as Settings {
				width 1515; height 1044
				at Settings_header { width 1515 }
				replace Settings_header.left.Button_ghost_small {
					use Libraries.ui_kit.Actions.Button as "Button/ghost/small" {
						kind ghost; size small
						replace icon_kit_Plus {
							use Libraries.ui_kit.Icon.chevronL as "icon/chevronL" { border-color #5a667e; line-width 1 }
						}
						at Button { title "К проекту" }
					}
				}
				at Settings_header.left.Settings { title "Настройки проекта" }
				at divider { width 1515 }
				at Settings_tabs { height 987 }
				at divider_2 { height 987 }
				at Settings_subtabs { hidden no; auto-layout column; gap 16; padding 24 32; align start; width 1282; height 987 }
				at Settings_content { hidden yes }
				slot right {
					use Libraries.ui_kit.Actions.Button as "Close settings" {
						kind tertiary; size small; shape icon
						replace icon_gear {
							use Libraries.ui_kit.Icon.x as "icon/x" { border-color #5a667e; line-width 1 }
						}
					}
				}
				slot Settings_tabs {
					use Libraries.workbench.NavItem as "NavItem/Основное" {
						width 208
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.gear as "icon/gear" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Основное }
					}
					use Libraries.workbench.NavItem as "NavItem/Участники и доступ" {
						selected true; width 208
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.users as "icon/users" { border-color #cf13a2; line-width 1 }
						}
						at Issues { title "Участники и доступ" }
					}
					use Libraries.workbench.NavItem as "NavItem/Задачи" {
						width 208
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.check as "icon/check" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Задачи }
					}
					use Libraries.workbench.NavItem as "NavItem/Статусы и workflow" {
						width 208
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.timeline as "icon/timeline" { border-color #0f121a; line-width 1 }
						}
						at Issues { title "Статусы и workflow" }
					}
					use Libraries.workbench.NavItem as "NavItem/Архив" {
						width 208
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.trash as "icon/trash" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Архив }
					}
				}
				slot Settings_subtabs {
					use Libraries.settings_kit.SectionTitle as "Section Участники и доступ" {
						at Title { title "Участники и доступ" }
						at Hint_of_the_section { hidden no; title "Кто видит проект и кто может его настраивать."; width 720 }
					}
					use Libraries.settings_kit.FormRow as "Row Приватный проект" {
						at label.Label { title "Приватный проект" }
						at label.Hint { hidden no; title "Видят только участники" }
						slot control {
							use Libraries.ui_kit.Forms.Toggle as Toggle {
								on false
								at Label { hidden yes }
							}
						}
					}
					use Libraries.settings_kit.FormRow as "Row Автовступление" {
						at label.Label { title Автовступление }
						at label.Hint { hidden no; title "Новые сотрудники становятся участниками автоматически" }
						slot control {
							use Libraries.ui_kit.Forms.Toggle as Toggle {
								on false
								at Label { hidden yes }
							}
						}
					}
					item divider { auto-layout abs; width 720; height 1; clip yes; color #0000000f }
					item "members head" {
						auto-layout row; align center; justify space-between; width 760; height 32; clip yes
						item "Участники · 4" { title "Участники · 4"; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left }
						use Libraries.ui_kit.Actions.Button as "Button/secondary/small" {
							kind secondary; size small
							replace icon_kit_Plus {
								use Libraries.ui_kit.Icon.plus as "icon/plus" { border-color #000000; line-width 1 }
							}
							at Button { title "Добавить участника" }
						}
					}
					use Libraries.settings_kit.Table as "Members table" {
						width 1218
						at head { width 1218 }
						at body { width 1218 }
						slot head {
							item th {
								auto-layout row; padding 0 12; align center; width 962; height 36; clip yes
								item Сотрудник { title Сотрудник; font-size 12; line-height 15; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #00000099 }
							}
							item th {
								auto-layout row; padding 0 12; align center; width 200; height 36; clip yes
								item Роль { title Роль; font-size 12; line-height 15; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #00000099 }
							}
							item th {
								auto-layout row; padding 0 12; align center; width 56; height 36; clip yes
								item spacer { auto-layout abs; width 1; height 1; clip yes }
							}
						}
						slot body {
							item divider { auto-layout abs; width 1218; height 1; clip yes; color #0000000f }
							item row {
								auto-layout row; align center; width 1218; clip yes
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 962; clip yes; wrap yes; line-gap 6
									item person {
										auto-layout row; gap 8; align center; clip yes
										use Libraries.ui_kit.People.Avatar as "Avatar/24" {
											width 24; height 24; color #4ca6ee; corner-radius 5
											at initials { title СА; font-size 10; line-height 13 }
										}
										item "Анна Смирнова" { title "Анна Смирнова"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
									}
								}
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 200; clip yes; wrap yes; line-gap 6
									use Libraries.ui_kit.Forms.Input as Input {
										at field { width 160 }
										at field.Value { title Владелец }
										at field.grow { hidden no }
										at field.icon_chevronD { hidden no }
									}
								}
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 56; clip yes; wrap yes; line-gap 6
									use Libraries.ui_kit.Actions.Button as "IconButton/more" {
										kind tertiary; size extra-small; shape icon
										replace icon_gear {
											use Libraries.ui_kit.Icon.more as "icon/more" { border-color #5a667e; line-width 1 }
										}
									}
								}
							}
							item divider { auto-layout abs; width 1218; height 1; clip yes; color #0000000f }
							item row {
								auto-layout row; align center; width 1218; clip yes
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 962; clip yes; wrap yes; line-gap 6
									item person {
										auto-layout row; gap 8; align center; clip yes
										use Libraries.ui_kit.People.Avatar as "Avatar/24" {
											width 24; height 24; color #83af12; corner-radius 5
											at initials { title КМ; font-size 10; line-height 13 }
										}
										item "Мария Козлова" { title "Мария Козлова"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
									}
								}
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 200; clip yes; wrap yes; line-gap 6
									use Libraries.ui_kit.Forms.Input as Input {
										at field { width 160 }
										at field.Value { title Участник }
										at field.grow { hidden no }
										at field.icon_chevronD { hidden no }
									}
								}
								item td {
									auto-layout row; gap 6; padding 6 12; align center; width 56; clip yes; wrap yes; line-gap 6
									use Libraries.ui_kit.Actions.Button as "IconButton/more" {
										kind tertiary; size extra-small; shape icon
										replace icon_gear {
											use Libraries.ui_kit.Icon.more as "icon/more" { border-color #5a667e; line-width 1 }
										}
									}
								}
							}
							item divider { auto-layout abs; width 1218; height 1; clip yes; color #0000000f }
