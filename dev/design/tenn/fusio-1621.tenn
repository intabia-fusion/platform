					}
					use Libraries.workbench.NavItem as "NavItem/Архив" {
						width 208
						replace icon_kit_CheckSquare {
							use Libraries.ui_kit.Icon.trash as "icon/trash" { border-color #0f121a; line-width 1 }
						}
						at Issues { title Архив }
					}
				}
				slot Settings_subtabs {
					use Libraries.settings_kit.SectionTitle as "Section Статусы и workflow" {
						at Title { title "Статусы и workflow" }
						at Hint_of_the_section {
							hidden no; title "Статусы задаются типом проекта «Default» и общие для всех его проектов. Доски группируют эти статусы в колонки."; width 760
						}
					}
					item Statuses {
						auto-layout column; gap 12; width 760; clip yes
						item "category Бэклог" {
							auto-layout column; gap 6; clip yes
							item Бэклог { title БЭКЛОГ; font-size 12; line-height 15; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #00000099 }
							item "status Backlog" {
								auto-layout row; gap 8; padding 0 12; align center; width 760; height 36; clip yes; color #f7f7f8; corner-radius 6
								use Libraries.ui_kit.Status.StatusIcon as "Status/StatusIcon/backlog" { category backlog }
								item Backlog { title Backlog; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
							}
						}
						item "category К выполнению" {
							auto-layout column; gap 6; clip yes
							item "К выполнению" {
								title "К ВЫПОЛНЕНИЮ"; font-size 12; line-height 15; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #00000099
							}
							item "status Todo" {
								auto-layout row; gap 8; padding 0 12; align center; width 760; height 36; clip yes; color #f7f7f8; corner-radius 6
								use Libraries.ui_kit.Status.StatusIcon as "Status/StatusIcon/todo" { category todo }
								item Todo { title Todo; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
							}
						}
						item "category В работе" {
							auto-layout column; gap 6; clip yes
							item "В работе" { title "В РАБОТЕ"; font-size 12; line-height 15; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #00000099 }
							item "status In Progress" {
								auto-layout row; gap 8; padding 0 12; align center; width 760; height 36; clip yes; color #f7f7f8; corner-radius 6
								use Libraries.ui_kit.Status.StatusIcon as "Status/StatusIcon/active" { category active }
								item "In Progress" { title "In Progress"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
							}
						}
						item "category Выполнено" {
							auto-layout column; gap 6; clip yes
							item Выполнено { title ВЫПОЛНЕНО; font-size 12; line-height 15; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #00000099 }
							item "status Done" {
								auto-layout row; gap 8; padding 0 12; align center; width 760; height 36; clip yes; color #f7f7f8; corner-radius 6
								use Libraries.ui_kit.Status.StatusIcon as "Status/StatusIcon/won" { category won }
								item Done { title Done; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
							}
						}
						item "category Отменено" {
							auto-layout column; gap 6; clip yes
							item Отменено { title ОТМЕНЕНО; font-size 12; line-height 15; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #00000099 }
							item "status Canceled" {
								auto-layout row; gap 8; padding 0 12; align center; width 760; height 36; clip yes; color #f7f7f8; corner-radius 6
								use Libraries.ui_kit.Status.StatusIcon as "Status/StatusIcon/lost" { category lost }
								item Canceled { title Canceled; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
							}
						}
					}
					item actions {
						auto-layout row; gap 8; align center; clip yes
						use Libraries.ui_kit.Actions.Button as "Button/secondary/small" {
							kind secondary; size small
							replace icon_kit_Plus {
								use Libraries.ui_kit.Icon.gear as "icon/gear" { border-color #000000; line-width 1 }
							}
							at Button { title "Изменить статусы в типе проекта" }
						}
						use Libraries.ui_kit.Actions.Button as "Button/ghost/small" {
							kind ghost; size small
							replace icon_kit_Plus {
								use Libraries.ui_kit.Icon.timeline as "icon/timeline" { border-color #5a667e; line-width 1 }
							}
							at Button { title "Workflow mapping" }
						}
					}
				}
			}
		}
	}
