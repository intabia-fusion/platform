entry "../../../PlatformDesign.tenn"

item "Кадр 1: landing" {
    auto-layout abs; width 660; height 1000; clip yes; pos 0 0
    item head1 {
      auto-layout row; gap 10; align center; width 620; pos 20 -24
      item num1 {
        auto-layout row; width 28; height 28; align center; justify center; color #cf13a2; corner-radius 14
        item n1 { title 1; font-size 13; font-weight 700; text-color #ffffff }
      }
      item t1 { title "Landing: рабочая почта"; width fill; font-size 15; font-weight 600; text-color #201240; layout left }
    }
    item scene1 {
      auto-layout abs; width 620; height 680; color #130228; corner-radius 12; clip yes; pos 20 -100
      item beam1 { width 14; height 680; color linear 90 #a96bff00 0 #a96bff73 0.5 #a96bff00 1; pos 452 0 }
      item balll1 { width 84; height 84; corner-radius 42; color linear 45 #5b25a8 0 #0e0220 1; pos 385 -380 }
      item disc1 { width 250; height 105; corner-radius 52; color linear 135 #7a3fd0 0 #24083f 1; pos 380 -300 }
      item ballt1 { width 84; height 84; corner-radius 42; color linear 45 #8a4de0 0 #180533 1; pos 455 -153 }
      item top1 {
        auto-layout row; width 620; padding 12 16; gap 8; align center; pos 0 -14
        item lg1 {
          auto-layout row; gap 6; align center
          item mark1 {
            auto-layout row; width 16; height 16; align center; justify center; color #6c3bd4; corner-radius 4
            item mk1 { title P; font-size 9; font-weight 700; text-color #ffffff }
          }
          item lgt1 {
            auto-layout column; gap 0
            item lgt1a { title ИНТАБИЯ; font-size 6; font-weight 700; line-height 7; text-color #ffffff; layout left }
            item lgt1b { title ПЛАТФОРМА; font-size 6; font-weight 700; line-height 7; text-color #a96bff; layout left }
          }
        }
        item menu1 {
          auto-layout row; gap 8; align center
          item mn1 { title Инструменты; font-size 6; line-height 8; text-color #ffffffb3 }
          item mn2 { title Тарифы; font-size 6; line-height 8; text-color #ffffffb3 }
          item mn3 { title Блог; font-size 6; line-height 8; text-color #ffffffb3 }
          item mn4 { title Контакты; font-size 6; line-height 8; text-color #ffffffb3 }
        }
        item grow1 { width fill }
        item d1 {
          auto-layout row; padding 4 10; align center; corner-radius 999; border-color #6c3bd4
          item dt1 { title Демо; font-size 8; line-height 10; text-color #ffffff }
        }
        item li1 {
          auto-layout row; padding 4 12; align center; corner-radius 999; border-color #ffffff66
          item lt1 { title Войти; font-size 8; line-height 10; text-color #ffffff }
        }
      }
      item hero1 {
        auto-layout column; width 300; gap 8; pos 30 -250
        item h1s {
          auto-layout column; gap 1; width fill
          item l1a { title Управляйте; width fill; font-size 22; font-weight 700; line-height 26; text-color #ffffff; layout left }
          item l1b { title "командной работой"; width fill; font-size 20; font-weight 700; line-height 26; text-color #ffffff; layout left }
          item l1c { title "на единой AI-платформе"; width fill; font-size 22; font-weight 700; line-height 26; text-color #a96bff; layout left }
        }
        item lead1 { title "Задачи, документы, встречи и договорённости - в одном контуре, без потери рабочего контекста."; width fill; font-size 9; line-height 12; text-color #ffffffb3; layout left }
        item row1 {
          auto-layout row; gap 6; width fill; align center
          item f1 {
            auto-layout row; width 150; height 28; padding 0 10; align center; color #ffffff12; border-color #ffffff2e; corner-radius 6
            item ph1 { title "Рабочая почта"; width fill; font-size 8; line-height 10; text-color #ffffff8c; layout left }
          }
          item cta1 {
            auto-layout row; padding 8 12; align center; justify center; color #f5f1e8; corner-radius 999
            item ct1 { title Продолжить; font-size 8; font-weight 600; line-height 10; text-color #201240 }
          }
        }
        item cap1 { title "Без привязки карты. Можно начать одному. Бесплатно для команд до 5 человек."; width fill; font-size 7; line-height 9; text-color #ffffff99; layout left }
      }
    }
    item caption1 { title "Email вводится один раз, дальше без повторного ввода"; width 620; font-size 12; line-height 16; text-color #5c6470; layout left; pos 26 -808 }
  }

  item arrow1 { title ">"; font-size 22; text-color #a3a3ad; pos 684 -340 }

  item "Кадр 2: пароль" {
    auto-layout abs; width 660; height 1000; clip yes; pos 720 0
    item head2 {
      auto-layout row; gap 10; align center; width 620; pos 20 -24
      item num2 {
        auto-layout row; width 28; height 28; align center; justify center; color #cf13a2; corner-radius 14
        item n2 { title 2; font-size 13; font-weight 700; text-color #ffffff }
      }
      item t2 { title "Вход: пароль, email подставлен"; width fill; font-size 15; font-weight 600; text-color #201240; layout left }
    }
    item scene2 {
      auto-layout abs; width 620; height 680; color #f3f3f6; corner-radius 12; clip yes; pos 20 -100
      use Libraries.login_kit.LoginCard as Card2 {
        pos 80 -60
        slot content {
          use Libraries.login_kit.LoginForm as Form2 {
            slot content {
              item form2 {
                auto-layout column; gap 16; width 396; clip yes; font-family "IBM Plex Sans"
                item h2s {
                  auto-layout column; gap 8; width 396; align center
                  item t2s { title "С возвращением"; font-size 24; font-weight 700; line-height 30; text-color #000061 }
                  item e2r {
                    auto-layout row; gap 6; align center; justify center; width 396
                    item e2 { title "anna.smirnova@intabia.io"; font-size 12; line-height 16; text-color #000061 }
                    item c2 { title "Сменить"; font-size 12; line-height 16; text-color #6e48ce }
                  }
                  item s2 { title "После входа - сразу в последнее активное пространство"; width fill; font-size 11; line-height 15; text-color #5c6470; layout left }
                }
                use Libraries.login_kit.LoginField as "F2 Пароль" {
                  label Пароль
                  at Value { title "********" }
                }
                use Libraries.login_kit.LoginButton as "B2 Войти" {
                  at Button { title Войти }
                }
                item hint2 { title "Сменить пространство можно внутри продукта"; width fill; font-size 10; line-height 13; text-color #7f7f7f; layout left }
              }
            }
          }
        }
      }
    }
    item caption2 { title "Существующий с паролем; поле email не показываем"; width 620; font-size 12; line-height 16; text-color #5c6470; layout left; pos 36 -794 }
  }

  item arrow2 { title ">"; font-size 22; text-color #a3a3ad; pos 1404 -340 }

  item "Кадр 3: последнее пространство" {
