      auto-layout column; width 620; height 680; color #ffffff; corner-radius 12; border-color #00000014; clip yes; pos 20 -100
      item wtop3 {
        auto-layout row; width fill; padding 10 14; gap 8; align center
        item dots3 {
          auto-layout row; gap 4; align center
          item d3a { width 8; height 8; corner-radius 4; color #00000022 }
          item d3b { width 8; height 8; corner-radius 4; color #00000022 }
          item d3c { width 8; height 8; corner-radius 4; color #00000022 }
        }
        item wt3 { title "Intabia Platform"; width fill; font-size 12; font-weight 600; text-color #201240; layout left }
        item wh3 { title "последнее активное"; font-size 9; line-height 12; text-color #7f7f7f }
      }
      item wbody3 {
        auto-layout row; width fill; height fill
        item rail3 {
          auto-layout column; width 36; padding 10 0; gap 8; align center; color #fafafc
          item r3a { width 16; height 16; corner-radius 4; color #e5e1ea }
          item r3b { width 16; height 16; corner-radius 4; color #cf13a2 }
          item r3c { width 16; height 16; corner-radius 4; color #e5e1ea }
          item r3d { width 16; height 16; corner-radius 4; color #e5e1ea }
          item r3e { width 16; height 16; corner-radius 4; color #e5e1ea }
        }
        item wmain3 {
          auto-layout column; width fill; padding 14; gap 10
          item wtitle3 { title "Мои задачи"; font-size 13; font-weight 600; text-color #201240; layout left }
          item task3a {
            auto-layout row; width fill; height 26; gap 8; align center
            item cb3a { width 10; height 10; corner-radius 3; border-color #00000033 }
            item bar3a { width 220; height 8; corner-radius 4; color #efedf2 }
          }
          item task3b {
            auto-layout row; width fill; height 26; gap 8; align center
            item cb3b { width 10; height 10; corner-radius 3; border-color #00000033 }
            item bar3b { width 160; height 8; corner-radius 4; color #efedf2 }
          }
          item task3c {
            auto-layout row; width fill; height 26; gap 8; align center
            item cb3c { width 10; height 10; corner-radius 3; color #cf13a2 }
            item bar3c { width 260; height 8; corner-radius 4; color #efedf2 }
          }
          item task3d {
            auto-layout row; width fill; height 26; gap 8; align center
            item cb3d { width 10; height 10; corner-radius 3; border-color #00000033 }
            item bar3d { width 190; height 8; corner-radius 4; color #efedf2 }
          }
        }
      }
      item wpanel3 {
        auto-layout row; width fill; padding 12 14; gap 8; align center; color #f8f5fa; border-color #d9b9d8
        item dotp3 { width 8; height 8; corner-radius 4; color #cf13a2 }
        item wp3 { title "Вошли сразу в последнее активное пространство. Сменить: меню профиля."; width fill; font-size 10; line-height 13; text-color #7d1f70; layout left }
      }
    }
    item caption3 { title "Последнее активное из профиля; если последнего нет - выбор или создание"; width 620; font-size 12; line-height 16; text-color #5c6470; layout left; pos 20 -470 }
  }

  item arrow3 { title ">"; font-size 22; text-color #a3a3ad; pos 2124 -340 }

  item "Кадр 4: код" {
    auto-layout abs; width 660; height 1000; clip yes; pos 2160 0
    item head4 {
      auto-layout row; gap 10; align center; width 620; pos 20 -24
      item num4 {
        auto-layout row; width 28; height 28; align center; justify center; color #cf13a2; corner-radius 14
        item n4 { title 4; font-size 13; font-weight 700; text-color #ffffff }
      }
      item t4 { title "Новый и OTP: код из письма"; width fill; font-size 15; font-weight 600; text-color #201240; layout left }
    }
    item scene4 {
      auto-layout abs; width 620; height 680; color #f3f3f6; corner-radius 12; clip yes; pos 20 -100
      use Libraries.login_kit.LoginCard as Card4 {
        pos 60 -80
        slot content {
          use Libraries.login_kit.LoginForm as Form4 {
            padding 16 24
            slot content {
              item form4 {
                auto-layout column; gap 20; width 412; clip yes; font-family "IBM Plex Sans"
                use Libraries.login_kit.LoginOtpHeader as Header4 {
                  at title_row.Enter_the_code { title "Введите код" }
                  at description.We_sent_the_code_to { title "Мы отправили код на" }
                  at description.name_example_com { title "anna.smirnova@intabia.io" }
                }
                use Libraries.login_kit.LoginCode as Code4 {
                  at digit_1._1 { title "4" }
                  at digit_2._2 { title "8" }
                  at digit_3._3 { title "2" }
                  at digit_4._4 { title "9" }
                  at digit_5._5 { title "1" }
                  at digit_6._6 { title "3" }
                }
                item hint4 { title "Не пришло письмо? Проверьте папку «Спам»."; width fill; font-size 11; line-height 14; text-color #00000066; layout left }
                item row4 {
                  auto-layout row; gap 14; width 412
                  item Resend4 { title "Отправить код повторно"; font-size 11; line-height 14; text-color #333333 }
                  item Alt4 { title "Сменить почту"; font-size 11; line-height 14; text-color #333333 }
                }
              }
            }
          }
        }
      }
    }
    item caption4 { title "Код для новых и когда требуется OTP; email подставлен"; width 620; font-size 12; line-height 16; text-color #5c6470; layout left; pos 26 -804 }
  }

  item arrow4 { title ">"; font-size 22; text-color #a3a3ad; pos 2844 -340 }

  item "Кадр 5: имя пространства" {
