                  at Button { title "Создать и продолжить" }
                }
              }
            }
          }
          use Libraries.login_kit.LoginAction as "A5 Приглашение" {
            at Action { title "У меня есть ссылка-приглашение" }
          }
        }
      }
    }
    item caption5 { title "Пространство начинает создаваться сразу, до заполнения профиля"; width 620; font-size 12; line-height 16; text-color #5c6470; layout left; pos 31 -798 }
  }

  item arrow5 { title ">"; font-size 22; text-color #a3a3ad; pos 3564 -340 }

  item "Кадр 6: профиль в фоне" {
    auto-layout abs; width 660; height 1000; clip yes; pos 3600 0
    item head6 {
      auto-layout row; gap 10; align center; width 620; pos 20 -24
      item num6 {
        auto-layout row; width 28; height 28; align center; justify center; color #cf13a2; corner-radius 14
        item n6 { title 6; font-size 13; font-weight 700; text-color #ffffff }
      }
      item t6 { title "Профиль, пространство в фоне"; width fill; font-size 15; font-weight 600; text-color #201240; layout left }
    }
    item scene6 {
      auto-layout abs; width 620; height 680; color #f3f3f6; corner-radius 12; clip yes; pos 20 -100
      use Libraries.login_kit.LoginCard as Card6 {
        pos 80 -10
        slot content {
          use Libraries.login_kit.LoginForm as Form6 {
            slot content {
              item form6 {
                auto-layout column; gap 14; width 396; clip yes; font-family "IBM Plex Sans"
                item h6s {
                  auto-layout column; gap 8; width 396; align center
                  item t6s { title "Ваш профиль"; font-size 24; font-weight 700; line-height 30; text-color #000061 }
                  item s6 { title "«Команда Анны» создаётся, пока вы заполняете форму"; width fill; font-size 12; line-height 16; text-color #5c6470; layout left }
                }
                use Libraries.login_kit.LoginStatus as Progress6 {
                  at message.Message { title "Создаём «Команда Анны»…" }
                }
                use Libraries.login_kit.LoginField as "F6 Имя" { label Имя; at Value { title Анна } }
                use Libraries.login_kit.LoginField as "F6 Фамилия" { label Фамилия; at Value { title Смирнова } }
                use Libraries.login_kit.LoginField as "F6 Телефон" { label "Телефон · необязательно"; at Value { hidden yes } }
                item consent6 {
                  auto-layout column; gap 6; width 396
                  use Libraries.login_kit.LoginCheckbox as "Check6 Согласие" {
                    checked true; label "Соглашаюсь с Условиями использования и обработкой персональных данных"
                  }
                  item links6 { title "Условия использования · Политика конфиденциальности"; width fill; font-size 10; line-height 13; text-color #6e48ce; layout left }
                }
                use Libraries.login_kit.LoginButton as "B6 Сохранить" {
                  at Button { title "Сохранить и войти" }
                }
              }
            }
          }
        }
      }
    }
    item caption6 { title "Имя и фамилия один раз на аккаунт; телефон необязателен; согласие одно"; width 620; font-size 12; line-height 16; text-color #5c6470; layout left; pos 25 -803 }
  }

  item arrow6 { title ">"; font-size 22; text-color #a3a3ad; pos 4284 -340 }

