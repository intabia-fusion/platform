  item "Кадр 8: ошибка создания" {
    auto-layout abs; width 660; height 1000; clip yes; pos 5040 0
    item head8 {
      auto-layout row; gap 10; align center; width 620; pos 20 -24
      item num8 {
        auto-layout row; width 28; height 28; align center; justify center; color #cf13a2; corner-radius 14
        item n8 { title 8; font-size 13; font-weight 700; text-color #ffffff }
      }
      item t8 { title "Ошибка создания - не тупик"; width fill; font-size 15; font-weight 600; text-color #201240; layout left }
    }
    item scene8 {
      auto-layout abs; width 620; height 680; color #f3f3f6; corner-radius 12; clip yes; pos 20 -100
      use Libraries.login_kit.LoginCard as Card8 {
        pos 80 -60
        slot content {
          use Libraries.login_kit.LoginForm as Form8 {
            slot content {
              item form8 {
                auto-layout column; gap 16; width 396; clip yes; font-family "IBM Plex Sans"
                item h8s {
                  auto-layout column; gap 8; width 396; align center
                  item t8s { title "Ваш профиль"; font-size 24; font-weight 700; line-height 30; text-color #000061 }
                  item s8 { title "Пространство не создано - вы ничего не потеряли"; width fill; font-size 12; line-height 16; text-color #5c6470; layout left }
                }
                use Libraries.login_kit.LoginStatus as Error8 {
                  kind error
                  at message.Message { title "Не удалось создать «Команда Анны». Профиль сохранён." }
                }
                use Libraries.login_kit.LoginField as "F8 Имя" { label Имя; at Value { title Анна } }
                use Libraries.login_kit.LoginField as "F8 Фамилия" { label Фамилия; at Value { title Смирнова } }
                item actions8 {
                  auto-layout row; gap 8; width 396
                  use Libraries.login_kit.LoginButton as "B8 Повторить" {
                    width 190
                    at Button { title Повторить }
                  }
                  use Libraries.login_kit.LoginButton as "B8 Войти" {
                    kind default; width 190
                    at Button { title "Войти и создать позже" }
                  }
                }
              }
            }
          }
        }
      }
    }
    item caption8 { title "Профиль сохранён: повторить создание или войти и создать позже"; width 620; font-size 12; line-height 16; text-color #5c6470; layout left; pos 21 -825 }
  }

