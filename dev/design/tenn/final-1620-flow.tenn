      item t5 { title "Новый: имя пространства"; width fill; font-size 15; font-weight 600; text-color #201240; layout left }
    }
    item scene5 {
      auto-layout abs; width 620; height 680; color #f3f3f6; corner-radius 12; clip yes; pos 20 -100
      use Libraries.login_kit.LoginCard as Card5 {
        pos 80 -110
        slot content {
          use Libraries.login_kit.LoginForm as Form5 {
            slot content {
              item form5 {
                auto-layout column; gap 20; width 396; clip yes; font-family "IBM Plex Sans"
                item h5s {
                  auto-layout column; gap 8; width 396; align center
                  item t5s { title "Сначала пространство"; font-size 24; font-weight 700; line-height 30; text-color #000061 }
                  item s5 { title "Назовите его - создадим, пока вы заполняете профиль"; width fill; font-size 12; line-height 16; text-color #5c6470; layout left }
                }
                use Libraries.login_kit.LoginField as "F5 Название" {
                  label "Название пространства"
