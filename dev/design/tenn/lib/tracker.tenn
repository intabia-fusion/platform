}
item "IssueCard/compact" {
	auto-layout column; gap 6; padding 8 10; width 234; clip yes; color #ffffff; border-color #0000000f; corner-radius 8; shadow 0 -1 3 #0000000f; pos 556 -44
	item "title row" {
		auto-layout row; gap 6; width fill; clip yes
		item "StatusIcon/active" {
			auto-layout abs; width 16; height 16
			item ring { width 14; height 14; corner-radius 7; border-color #5195d7; line-width 1.5; pos 1 -1 }
			item wedge { width 16; height 16; path "M8 8L8 3A5 5 0 0 1 13 8Z"; view-box 0 0 16 16; color #5195d7 }
		}
		item title {
			title "Fix the board layout when a column has no limit"; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 500; layout left; width fill
		}
		use ui_kit.People.Avatar as "Avatar/20" {
			color #6260c2; corner-radius 10
			at initials { title AJ; font-size 8; line-height 10 }
		}
	}
	item meta {
		auto-layout row; gap 8; align center; width fill; clip yes
		slot meta {
			item "APP-12" { title APP-12; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
			use ui_kit.Status.PriorityIcon_high as "Status/PriorityIcon/high"
			use ui_kit.Icon.subissues as "icon/subissues" { width 14; height 14; border-color #00000099; line-width 1.14 }
			use ui_kit.Icon.calendar as "icon/calendar" { width 14; height 14; border-color #00000099; line-width 1.14 }
			use ui_kit.Icon.component as "icon/component" { width 14; height 14; border-color #00000099; line-width 1.14 }
			item _4h { title "4h"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
		}
	}
}
item "IssueCard/dense" {
	auto-layout column; gap 4; padding 6 10; width 234; clip yes; color #ffffff; border-color #0000000f; corner-radius 8; shadow 0 -1 3 #0000000f; pos 822 -44
	item row {
		auto-layout row; gap 6; align center; width fill; clip yes
		item "StatusIcon/active" {
			auto-layout abs; width 16; height 16
			item ring { width 14; height 14; corner-radius 7; border-color #5195d7; line-width 1.5; pos 1 -1 }
			item wedge { width 16; height 16; path "M8 8L8 3A5 5 0 0 1 13 8Z"; view-box 0 0 16 16; color #5195d7 }
		}
		item "APP-12" { title APP-12; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
		item title { title "Fix the board layout…"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left }
		use ui_kit.People.Avatar as "Avatar/20" {
			color #6260c2; corner-radius 10
			at initials { title AJ; font-size 8; line-height 10 }
		}
	}
}
item ColumnHeader {
	auto-layout row; padding 0 4 0 20; align center; justify space-between; width 294; height 40; clip yes; color #d1dfee; border-color #0000000f; corner-radius 4
	pos 1152 -44
	item title {
		auto-layout row; gap 8; align center; clip yes
		use ui_kit.Status.StatusIcon_active as "Status/StatusIcon/active"
		item "In Progress" { title "In Progress"; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #2e7cc7 }
		item _6 { title "6"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
		item "/ 8" { hidden yes; title "/ 8"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
	}
	use ui_kit.Actions.Button as ColumnAction { kind secondary; size extra-small;
		hidden yes
		replace icon_kit_Plus {
			use ui_kit.Icon.milestone as "icon/milestone" { border-color #000000; line-width 1 }
		}
		at Button { title Release }
	}
	item "tools (hover)" {
		hidden yes; auto-layout row; gap 4; align center; clip yes
		use ui_kit.Actions.Button as "IconButton/chevronR" { kind tertiary; size small; shape icon;
			replace icon_gear {
				use ui_kit.Icon.chevronR as "icon/chevronR" { border-color #5a667e; line-width 1 }
			}
		}
		use ui_kit.Actions.Button as "IconButton/merge" { kind tertiary; size small; shape icon;
			replace icon_gear {
				use ui_kit.Icon.merge as "icon/merge" { border-color #5a667e; line-width 1 }
			}
		}
		use ui_kit.Actions.Button as "IconButton/plus" { kind tertiary; size small; shape icon;
			replace icon_gear {
				use ui_kit.Icon.plus as "icon/plus" { border-color #5a667e; line-width 1 }
			}
		}
	}
}
item KanbanColumn {
	auto-layout column; gap 8; padding 0 13; width 320; height 760; clip yes; pos 1542 -44
	use ColumnHeader as "ColumnHeader In Progress" {
		padding 0 8 0 20
		at title._6 { title "2" }
	}
	item spacer { auto-layout abs; width 294; height 1; clip yes }
	item statuses {
		hidden yes; auto-layout row; gap 4; padding 0 2; width 294; clip yes; wrap yes; line-gap 4
		slot statuses {
			use ui_kit.Status.StatusChip as "StatusChip/Review" {
				at In_Progress { title Review }
			}
			use ui_kit.Status.StatusChip as "StatusChip/Testing" {
				at In_Progress { title Testing }
			}
		}
	}
	item cards {
		auto-layout column; gap 8; padding 8; width 294; color #00000008; corner-radius 8
		slot cards {
			use IssueCard as "IssueCard APP-12" {
				width 278
				at top.left.parent { hidden no }
				at chips { width 248 }
				slot chips {
					item priority {
						auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
						use ui_kit.Status.PriorityIcon_high as "Status/PriorityIcon/high"
					}
					item "sub-issues" {
						auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
						use ui_kit.Icon.subissues as "icon/subissues" { width 14; height 14; border-color #00000099; line-width 1.14 }
						item "1/2" { title "1/2"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
					}
					item "due date" {
						auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
						use ui_kit.Icon.calendar as "icon/calendar" { width 14; height 14; border-color #00000099; line-width 1.14 }
						item "30 Oct" { title "30 Oct"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
					}
					item component {
						auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
						use ui_kit.Icon.component as "icon/component" { width 14; height 14; border-color #00000099; line-width 1.14 }
						item iOS { title iOS; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
					}
					item label {
						auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
						item dot { width 8; height 8; corner-radius 4; color #4ca6ee }
						item bug { title bug; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
					}
					item label {
						auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
						item dot { width 8; height 8; corner-radius 4; color #d27540 }
						item ux { title ux; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
					}
				}
			}
			use IssueCard_normal as "IssueCard APP-13" {
				padding 12 14; width 278
				at top.left.id { title APP-13 }
				at chips { width 248 }
				slot chips {
					item priority {
						auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
						use ui_kit.Status.PriorityIcon_high as "Status/PriorityIcon/high"
					}
					item "sub-issues" {
						auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
						use ui_kit.Icon.subissues as "icon/subissues" { width 14; height 14; border-color #00000099; line-width 1.14 }
						item "1/2" { title "1/2"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
					}
					item "due date" {
						auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
						use ui_kit.Icon.calendar as "icon/calendar" { width 14; height 14; border-color #00000099; line-width 1.14 }
						item "30 Oct" { title "30 Oct"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
					}
					item component {
						auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
						use ui_kit.Icon.component as "icon/component" { width 14; height 14; border-color #00000099; line-width 1.14 }
						item iOS { title iOS; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
					}
				}
			}
		}
	}
}
item IssueRow {
	auto-layout column; width 1481; height 44; clip yes; color #f7f7f8; pos 24 -920
	item row {
		auto-layout row; gap 4; padding 0 24 0 12; align center; width 1481; height 43; clip yes
		slot row {
			item check { width 16; height 16; clip yes; border-color #cf13a233; corner-radius 4 }
			item spacer { auto-layout abs; width 4; height 1; clip yes }
			item priority {
				auto-layout row; align center; width 16; height 16; clip yes
				use ui_kit.Status.PriorityIcon_high as "Status/PriorityIcon/high"
			}
			item id {
				auto-layout row; align center; width 49; height 18; clip yes
				item "APP-12" { title APP-12; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #00000080 }
			}
			item status {
				auto-layout row; padding 0 0 0 14; width 30; height 16; clip yes
				item "StatusIcon/active" {
					auto-layout abs; width 16; height 16
					item ring { width 14; height 14; corner-radius 7; border-color #5195d7; line-width 1.5; pos 1 -1 }
					item wedge { width 16; height 16; path "M8 8L8 3A5 5 0 0 1 13 8Z"; view-box 0 0 16 16; color #5195d7 }
				}
			}
			item title { title "Fix the board layout when a column has no limit"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
			use ui_kit.TagsAndFilters.Chip as "sub-issues" {
				slot content {
					use ui_kit.Icon.subissues as "icon/subissues" { width 14; height 14; border-color #00000099; line-width 1.14 }
					item "_1/2" { title "1/2"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; auto-layout row; text-color #000000cc }
				}
			}
			item comments {
				auto-layout row; gap 3; align center; clip yes
				use ui_kit.Icon.comment as "icon/comment" { width 14; height 14; border-color #00000099; line-width 1.14 }
				item _3 { title "3"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
			}
			item attachments {
				auto-layout row; gap 3; align center; clip yes
				use ui_kit.Icon.clip as "icon/clip" { width 14; height 14; border-color #00000099; line-width 1.14 }
				item _1 { title "1"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
			}
			item grow { auto-layout abs; width fill; height 1; clip yes }
			item "Label bug" {
				auto-layout row; gap 6; padding 0 8; align center; height 28; clip yes; color #6b3ad31a; border-color #00000017; corner-radius 24
				item dot { auto-layout abs; width 8; height 8; clip yes; color #4ca6ee; corner-radius 4 }
				item bug { title bug; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
			}
			item "ListChip/milestone" {
				auto-layout row; gap 6; padding 0 8; align center; height 28; clip yes; color #f2f2f4; border-color #00000017; corner-radius 24
				use ui_kit.Icon.milestone as "icon/milestone" { border-color #00000080; line-width 1 }
				item "Release 1.0" { title "Release 1.0"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000080 }
			}
			item "ListChip/component" {
				auto-layout row; gap 6; padding 0 8; align center; height 28; clip yes; color #f2f2f4; border-color #00000017; corner-radius 24
				use ui_kit.Icon.component as "icon/component" { border-color #00000080; line-width 1 }
				item iOS { title iOS; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000080 }
			}
			item "ListChip/calendar" {
				auto-layout row; gap 6; padding 0 8; align center; height 28; clip yes; color #f2f2f4; border-color #00000017; corner-radius 24
				use ui_kit.Icon.calendar as "icon/calendar" { border-color #00000080; line-width 1 }
				item "_30 Oct" { title "30 Oct"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000080 }
			}
			item divider {
				auto-layout row; padding 0 6 0 14; width 21; height 24; clip yes
				item line { auto-layout abs; width 1; height 24; clip yes; color #00000012 }
			}
			item "col reported" {
				auto-layout row; align center; width 16; height 18; clip yes
				item reported { title "2h"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000080 }
			}
			item "divider 2" {
				auto-layout row; padding 0 6 0 14; width 21; height 24; clip yes
				item line { auto-layout abs; width 1; height 24; clip yes; color #00000012 }
			}
			item estimation {
				auto-layout row; gap 8; align center; width 40; height 18; clip yes
				item ProgressCircle {
					auto-layout abs; width 16; height 16
					item ring { width 12; height 12; corner-radius 6; border-color #00000099; line-width 1.5; opacity 0.5; pos 2 -2 }
					item fill { width 16; height 16; path "M8 8L8 3A5 5 0 0 1 8 13Z"; view-box 0 0 16 16; color #00000099 }
				}
				item _4h { title "4h"; font-size 13; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #00000080 }
			}
			item "divider 3" {
				auto-layout row; padding 0 6 0 14; width 21; height 24; clip yes
				item line { auto-layout abs; width 1; height 24; clip yes; color #00000012 }
			}
			item "col created" {
				auto-layout row; align center; width 58; height 18; clip yes
				item created { title "2 days ago"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
			}
			item "divider 4" {
				auto-layout row; padding 0 6 0 14; width 21; height 24; clip yes
