entry "../../../../PlatformDesign.tenn"
item "§ IssueCard" {
	auto-layout abs; width 1080; height 252; border-color #0000000f; corner-radius 8; pos 0 0
	item title { title IssueCard; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ ColumnHeader" {
	auto-layout abs; width 342; height 108; border-color #0000000f; corner-radius 8; pos 1128 0
	item title { title ColumnHeader; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ KanbanColumn" {
	auto-layout abs; width 368; height 828; border-color #0000000f; corner-radius 8; pos 1518 0
	item title { title KanbanColumn; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ IssueRow" {
	auto-layout abs; width 1529; height 112; border-color #0000000f; corner-radius 8; pos 0 -876
	item title { title IssueRow; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ IssueGroup" {
	auto-layout abs; width 1529; height 232; border-color #0000000f; corner-radius 8; pos 0 -1036
	item title { title IssueGroup; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ IssueList" {
	auto-layout abs; width 1529; height 156; border-color #0000000f; corner-radius 8; pos 0 -1316
	item title { title IssueList; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ IssuePage" {
	auto-layout abs; width 1563; height 1035; border-color #0000000f; corner-radius 8; pos 0 -1520
	item title { title IssuePage; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ NewIssuePopup" {
	auto-layout abs; width 768; height 459; border-color #0000000f; corner-radius 8; pos 1611 -1520
	item title { title NewIssuePopup; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item IssueCard {
	auto-layout column; gap 8; padding 12 14; width 234; clip yes; color #ffffff; border-color #0000000f; corner-radius 8; shadow 0 -1 3 #0000000f; pos 24 -44
	item top {
		auto-layout row; align center; justify space-between; width fill; clip yes
		item left {
			auto-layout row; gap 4; align center; clip yes
			item id { title APP-12; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
			item parent { hidden yes; title "› Mobile app redesign"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
		}
		use ui_kit.People.Avatar as "Avatar/20" {
			color #6260c2; corner-radius 10
			at initials { title AJ; font-size 8; line-height 10 }
		}
	}
	item "title row" {
		auto-layout row; gap 8; width fill; clip yes
		item "StatusIcon/active" {
			auto-layout abs; width 16; height 16
			item ring { width 14; height 14; corner-radius 7; border-color #5195d7; line-width 1.5; pos 1 -1 }
			item wedge { width 16; height 16; path "M8 8L8 3A5 5 0 0 1 13 8Z"; view-box 0 0 16 16; color #5195d7 }
		}
		item title {
			title "Fix the board layout when a column has no limit"; font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 500; layout left; width fill
		}
	}
	item chips {
		auto-layout row; gap 6; width 204; clip yes; wrap yes; line-gap 6
		slot chips {
			item priority {
				auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
				use ui_kit.Status.PriorityIcon_high as "Status/PriorityIcon/high"
			}
			item "sub-issues" {
				auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
				use ui_kit.Icon.subissues as "icon/subissues" { width 14; height 14; border-color #00000099; line-width 1.14 }
				item "_1/2" { title "1/2"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
			}
			item "due date" {
				auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
				use ui_kit.Icon.calendar as "icon/calendar" { width 14; height 14; border-color #00000099; line-width 1.14 }
				item "_30 Oct" { title "30 Oct"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
			}
			item component {
				auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
				use ui_kit.Icon.component as "icon/component" { width 14; height 14; border-color #00000099; line-width 1.14 }
				item iOS { title iOS; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
			}
			item label {
				auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
				item dot { width 8; height 8; corner-radius 4; color #4ca6ee }
				item bug { title bug; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
			}
			item "label 2" {
				auto-layout row; gap 6; padding 3 8; align center; clip yes; color #ffffff; border-color #00000017; corner-radius 12
				item dot { width 8; height 8; corner-radius 4; color #d27540 }
				item ux { title ux; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
			}
		}
	}
	item footer { title "Оценка 4h"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
}
item "IssueCard/normal" {
	auto-layout column; gap 8; padding 10 12; width 234; clip yes; color #ffffff; border-color #0000000f; corner-radius 8; shadow 0 -1 3 #0000000f; pos 290 -44
	item top {
		auto-layout row; align center; justify space-between; width fill; clip yes
		item left {
			auto-layout row; gap 4; align center; clip yes
			item id { title APP-12; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099 }
