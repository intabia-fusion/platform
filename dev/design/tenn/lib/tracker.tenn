item NewIssuePopup {
	auto-layout abs; width 720; height 391; clip yes; color #ffffff; corner-radius 8; shadow 0 0 8 #00000033; pos 1635 -1564
	item ai {
		auto-layout row; align center; justify center; width 32; height 32; clip yes; corner-radius 6; pos 620 -22
		use ui_kit.Icon.kit_Sparkle as "icon/kit/Sparkle" { width 20; height 20; color #cf13a2 }
