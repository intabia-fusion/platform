	item close {
		auto-layout row; align center; justify center; width 28; height 28; clip yes; corner-radius 6; pos 668 -24
		use ui_kit.Icon.kit_Cross as "icon/kit/Cross" { width 20; height 20; color #00000099 }
	}
	item title { title "Issue title"; font-size 20; line-height 25; font-family "IBM Plex Sans"; layout left; text-color #0000004d; pos 36 -96 }
	item description { title "Add description..."; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #00000099; pos 36 -155 }
