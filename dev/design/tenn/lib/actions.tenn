entry "../../../../PlatformDesign.tenn"
item "§ Button" {
	auto-layout abs; width 1544; height 340; border-color #0000000f; corner-radius 8; pos 0 0
	item title { title Button; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ Switcher" {
	auto-layout abs; width 356; height 100; border-color #0000000f; corner-radius 8; pos 1592 0
	item title { title Switcher; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ Menu" {
	auto-layout abs; width 308; height 209; border-color #0000000f; corner-radius 8; pos 1996 0
	item title { title Menu; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ ClassicButton" {
	auto-layout abs; width 1548; height 240; border-color #0000000f; corner-radius 8; pos 0 -388
	item title { title ClassicButton; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ Modal" {
	auto-layout abs; width 648; height 240; border-color #0000000f; corner-radius 8; pos 1596 -388
	item title { title Modal; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item Button {
	export let label = Button
	export let kind = primary
	export let size = medium
	export let shape = default
	styles {
		primary { color #6b3ad3; border-color #1725471a; text-color #ffffff }
		secondary { color #1725470d; border-color #1725471a; text-color #0f121a }
		tertiary { color none; border-color none; text-color #6b3ad3 }
		ghost { color none; border-color none; text-color #0f121a }
		negative { color #cb4b42; border-color #d1d5de26; text-color #ffffff }
		brand { color #cf13a2; border-color none; text-color #ffffff }
		large { height 48; min-width 48; gap 8; padding 0 16; corner-radius 8 }
		medium { height 40; min-width 40; gap 8; padding 0 16; corner-radius 8 }
		small { height 32; min-width 32; gap 4; padding 0 8; corner-radius 6 }
		extra-small { height 24; min-width 24; gap 4; padding 0 8; corner-radius 4 }
		icon-only { padding 0 }
		kind one-of primary secondary tertiary ghost negative brand
		size one-of large medium small extra-small
		shape one-of default icon
	}
	auto-layout row; align center; justify center; clip yes
	use-style ${kind} ${size} ${shape === "icon" ? "icon-only" : ""}
	use Icon.kit_Plus as "icon/kit/Plus" { hidden ${shape === "icon"} }
	use Icon.gear as "icon/gear" { hidden ${shape !== "icon"} }
	item Button { title ${label}; hidden ${shape === "icon"}; font-size 14; line-height 16; font-family "IBM Plex Sans"; font-weight 500; layout left }
	use Icon.chevronD as "icon/chevronD" { hidden yes; width 14; height 14; line-width 1.14 }
}
item Switcher {
	auto-layout row; gap 4; align center; height 32; clip yes; color #f0f0f0; corner-radius 6; pos 1616 -44
	slot content {
		item "element All" {
			auto-layout row; padding 0 12; align center; justify center; height 32; clip yes; corner-radius 6
			item All { title All; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #5a667e }
		}
		item "element Active" {
			auto-layout row; padding 0 12; align center; justify center; height 32; clip yes; color #a5bdff40; corner-radius 6
			item Active { title Active; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #0f121a }
		}
		item "element Backlog" {
			auto-layout row; padding 0 12; align center; justify center; height 32; clip yes; corner-radius 6
			item Backlog { title Backlog; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #5a667e }
		}
	}
}
item "Switcher/icons" {
	auto-layout row; gap 4; align center; height 32; clip yes; color #f0f0f0; corner-radius 6; pos 1856 -44
	slot content {
		item "element kit/BulletList" {
			auto-layout row; align center; justify center; width 32; height 32; clip yes; corner-radius 6
			use Icon.kit_BulletList as "icon/kit/BulletList" { color #3c4149 }
		}
		item "element kit/Kanban" {
			auto-layout row; align center; justify center; width 32; height 32; clip yes; color #a5bdff40; corner-radius 6
			use Icon.kit_Kanban as "icon/kit/Kanban" { color #0f121a }
		}
	}
}
item Menu {
	auto-layout column; gap 2; padding 6; width 260; clip yes; color #ffffff; border-color #00000017; corner-radius 8; shadow 0 -8 24 #00000026; pos 2020 -44
	slot content {
		item header {
			auto-layout row; padding 0 8; align center; width 248; height 24; clip yes
			item Boards { title BOARDS; font-size 11; line-height 14; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #00000066 }
		}
		item "item/Main board" {
			auto-layout row; gap 8; padding 0 8; align center; width 248; height 32; clip yes; corner-radius 4
			use Icon.board as "icon/board" { border-color #00000099; line-width 1 }
			item "Main board" { title "Main board"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
			item grow { auto-layout abs; width fill; height 1; clip yes }
			use Icon.tick as "icon/tick" { border-color #205dc2; line-width 1 }
		}
		item "item/Releases" {
			auto-layout row; gap 8; padding 0 8; align center; width 248; height 32; clip yes; corner-radius 4
			use Icon.milestone as "icon/milestone" { border-color #00000099; line-width 1 }
			item Releases { title Releases; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
			item grow { auto-layout abs; width fill; height 1; clip yes }
			item _3 { title "3"; font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000066 }
		}
		item divider { auto-layout abs; width 248; height 1; clip yes; color #0000000f }
		item "item/New board" {
			auto-layout row; gap 8; padding 0 8; align center; width 248; height 32; clip yes; corner-radius 4
			use Icon.plus as "icon/plus" { border-color #00000099; line-width 1 }
			item "New board" { title "New board"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #cf13a2 }
		}
	}
}
item ClassicButton {
	export let label = Button
	export let kind = regular
	export let size = medium
	export let shape = default
	styles {
		regular { color #6b3ad31a; border-color #00000017; text-color #000000cc; icon_kit_Plus { color #00000099 }; icon_kit_PencilLine { color #00000099 }; icon_kit_CaretDownFill { color #00000099 } }
		primary { color #cf13a2; border-color #1725471a; text-color #ffffff }
		dangerous { color #eb5757; border-color #eb5757; text-color #ffffff }
		ghost { color none; border-color none; text-color #000000cc }
		icon { color none; border-color none; text-color #000000cc; icon_kit_Plus { color #00000099 }; icon_kit_PencilLine { color #00000099 }; icon_kit_CaretDownFill { color #00000099 } }
		small { height 28; min-width 28 }
		medium { height 32; min-width 32 }
		large { height 36; min-width 36 }
		icon-only { gap 6; padding 0 }
		kind one-of regular primary dangerous ghost icon
		size one-of small medium large
		shape one-of default icon
	}
	auto-layout row; gap 8; padding 0 12; align center; justify center; clip yes; corner-radius 6
	use-style ${kind} ${size} ${shape === "icon" ? "icon-only" : ""}
	use Icon.kit_Plus as "icon/kit/Plus" { hidden ${shape === "icon"} }
	use Icon.kit_PencilLine as "icon/kit/PencilLine" { hidden ${shape !== "icon"} }
	item Button { title ${label}; hidden ${shape === "icon"}; font-size 13; line-height 17; font-family "IBM Plex Sans"; layout left }
	use Icon.kit_CaretDownFill as "icon/kit/CaretDownFill" { hidden yes }
}
item "ClassicButton/regular/large/content" {
	auto-layout row; gap 6; padding 0 12; align center; justify center; height 36; clip yes; color #6b3ad31a; border-color #00000017; corner-radius 6
	pos 1372 -500
	slot content {
		item Content { title Content; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
	}
}
item "ClassicButton/ghost/large/content" {
	auto-layout row; gap 6; padding 0 12; align center; justify center; height 36; clip yes; corner-radius 6; pos 24 -568
	slot content {
		item Content { title Content; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left }
	}
}
item Modal {
	auto-layout column; padding 1; width 600; clip yes; color #ffffff; border-color #00000017; corner-radius 16; shadow 0 -24 24 #0e131e1f; pos 1620 -432
	item header {
		auto-layout row; padding 0 16; align center; justify space-between; width 598; height 56; clip yes
		item "Edit project" { title "EDIT PROJECT"; font-size 12; line-height 16; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #5a667e }
		use Button as Close { kind tertiary; size small; shape icon;
			replace icon_gear {
				use Icon.x as "icon/x" { border-color #6b3ad3; line-width 1 }
			}
		}
	}
	item divider { auto-layout abs; width 598; height 1; clip yes; color #0000000f }
	item body {
		auto-layout column; padding 16 24 32 24; width 598; clip yes
		slot body
	}
	item "divider 2" { auto-layout abs; width 598; height 1; clip yes; color #0000000f }
	item footer {
		auto-layout row; gap 8; padding 12; align center; justify end; width 598; height 64; clip yes
		use Button as "_Button/secondary/medium" { kind secondary; size medium;
			at icon_kit_Plus { hidden yes }
			at Button { title Cancel }
		}
		use Button as "_Button/primary/medium" { kind primary; size medium;
			at icon_kit_Plus { hidden yes }
			at Button { title Save }
		}
	}
}

element "Button catalog" {
	kind Screen
	item Catalog {
		auto-layout column; gap 12; padding 24; color #ffffff
		item primary {
			auto-layout row; gap 8; align center
			use Button as large { kind primary; size large }
			use Button as medium { kind primary; size medium }
			use Button as small { kind primary; size small }
			use Button as extra_small { kind primary; size extra-small }
			use Button as large_icon { kind primary; size large; shape icon }
			use Button as medium_icon { kind primary; size medium; shape icon }
