			use Button as extra_small_icon { kind ghost; size extra-small; shape icon }
		}
		item negative {
			auto-layout row; gap 8; align center
			use Button as large { kind negative; size large }
			use Button as medium { kind negative; size medium }
			use Button as small { kind negative; size small }
			use Button as extra_small { kind negative; size extra-small }
			use Button as large_icon { kind negative; size large; shape icon }
			use Button as medium_icon { kind negative; size medium; shape icon }
			use Button as small_icon { kind negative; size small; shape icon }
			use Button as extra_small_icon { kind negative; size extra-small; shape icon }
		}
		item brand {
			auto-layout row; gap 8; align center
			use Button as large { kind brand; size large }
			use Button as medium { kind brand; size medium }
			use Button as small { kind brand; size small }
			use Button as extra_small { kind brand; size extra-small }
			use Button as large_icon { kind brand; size large; shape icon }
			use Button as medium_icon { kind brand; size medium; shape icon }
			use Button as small_icon { kind brand; size small; shape icon }
			use Button as extra_small_icon { kind brand; size extra-small; shape icon }
		}
