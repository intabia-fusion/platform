	auto-layout abs; width 32; height 32; pos 1628 -1700
	item "path 1" {
		width 32; height 32; path "M64,0H448A64,64 0 0 1 512,64V448A64,64 0 0 1 448,512H64A64,64 0 0 1 0,448V64A64,64 0 0 1 64,0Z"; view-box 0 0 512 512
		color #f68423
	}
	item "path 2" {
		width 32; height 32
		path "m 416.99957,216.95084 c -39.2625,-22.18682 -78.9827,-34.64025 -117.0052,-39.52028 V 73.776502 l -60.66712,39.049158 v 63.02711 c -188.010218,14.68899 -295.068752,208.65924 0,262.37073 l 60.66712,-39.04916 V 218.28862 c 24.3468,4.22226 50.4759,12.17342 78.0094,24.69351 l -34.6758,21.70238 h 112.6719 v -73.76497 l -39.0003,26.0313 z m -177.67682,-1.66668 v 183.89018 c -182.841238,-23.72461 -140.809838,-171.94788 0,-183.89018 z"
