item LoginProviders {
	auto-layout column; gap 16; padding 16 0 0 0; width 396; clip yes; pos 1756 -1700
	slot content {
		item row {
			auto-layout row; gap 16; width 396; height 56; clip yes
			use LoginButton as "Button Sign in with Google" {
				kind provider; width 190
				at Button { title "Sign in with Google" }
			}
			use LoginButton as "Button Sign in with GitHub" {
				kind provider; width 190
				replace icon_google {
					use LoginIcon_github as "icon/github"
				}
				at Button { title "Sign in with GitHub" }
			}
		}
	}
}
item LoginCheckbox {
	export let checked = true; export let label = Label; export let invalid = false; auto-layout row; gap 11; padding 0 0 0 4; width 396; clip yes; pos 24 -1888
	item "box holder" {
		auto-layout column; padding 3 0 0 0; width 18; height 24; clip yes
		item box {
			auto-layout row; align center; justify center; width 18; height 18; clip yes; line-width 2; corner-radius 3.2
			color ${(checked === "true") ? "#cf13a2" : "#ffffff"}; border-color ${(invalid === "true") ? "#ee7a7a" : (checked === "true") ? "#cf13a2" : "#00000066"}
			use Libraries.ui_kit.Icon.tick as "icon/tick" { width 12; height 12; border-color #ffffff; line-width 0.98; hidden ${!(checked === "true")} }
		}
	}
	item Label { font-size 15.2; line-height 20; font-family "IBM Plex Sans"; layout left; width 363; text-color #201240; title ${label} }
}
item LoginLinks {
	auto-layout column; align center; width 396; clip yes; pos 516 -1888
	slot content {
		item "link row" {
			auto-layout row; gap 3; align center; justify center; width 396; clip yes; wrap yes; line-gap 3
			item Caption { title Caption; font-size 12.8; line-height 17; font-family "IBM Plex Sans"; layout left; text-color #333333 }
			item Link { title Link; font-size 12.8; line-height 17; font-family "IBM Plex Sans"; layout left; text-color #333333 }
		}
	}
}
item LoginAction {
	export let text = Action; auto-layout row; align center; justify center; width 460; height 18.5; clip yes; pos 1008 -1888
	item Action { font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #6e48ce; title ${text} }
}
item LoginOtpHeader {
	export let title = "Enter the code"; export let sent = "We sent the code to"; export let email = "name@example.com"; auto-layout column; gap 8; width 412
	clip yes; pos 1564 -1888
	item "title row" {
		auto-layout row; align center; justify start; width 412; height 36
		item back {
			auto-layout row; align center; justify center; width 36; height 36; clip yes; corner-radius 8
			use Libraries.ui_kit.Icon.kit_ChevronLeftLarge as "icon/kit/ChevronLeftLarge" { color #201240 }
		}
		item "Enter the code" { font-size 28; line-height 36; font-family "IBM Plex Sans"; font-weight 700; layout left; text-color #000061; title ${title} }
	}
	item description {
		auto-layout row; gap 8; align center; justify start; width 412; height 20; clip yes
		item "We sent the code to" { font-size 16; line-height 21; font-family "IBM Plex Sans"; layout left; text-color #333333; title ${sent} }
		item "name@example.com" { font-size 16; line-height 21; font-family "IBM Plex Sans"; layout left; text-color #000061; title ${email} }
	}
}
item LoginCode {
	export let digits = ""; auto-layout row; gap 6.4; align center; width 412; height 78; clip yes; pos 24 -2068
	item "digit 1" {
		auto-layout row; align center; justify center; width 60; height 78; clip yes; color #f3e5f5; border-color #00000017; corner-radius 12
		item _1 { font-size 32; line-height 42; font-family "IBM Plex Sans"; layout left; text-color #201240; title ${digits.length > 0 ? digits[0] : ""} }
	}
	item "digit 2" {
		auto-layout row; align center; justify center; width 60; height 78; clip yes; color #f3e5f5; border-color #00000017; corner-radius 12
		item _2 { font-size 32; line-height 42; font-family "IBM Plex Sans"; layout left; text-color #201240; title ${digits.length > 1 ? digits[1] : ""} }
	}
	item "digit 3" {
		auto-layout row; align center; justify center; width 60; height 78; clip yes; color #f3e5f5; border-color #00000017; corner-radius 12
		item _3 { font-size 32; line-height 42; font-family "IBM Plex Sans"; layout left; text-color #201240; title ${digits.length > 2 ? digits[2] : ""} }
	}
	item separator { auto-layout abs; width 12; height 1; clip yes; color #e5e7eb }
	item "digit 4" {
		auto-layout row; align center; justify center; width 60; height 78; clip yes; color #f3e5f5; border-color #00000017; corner-radius 12
		item _4 { font-size 32; line-height 42; font-family "IBM Plex Sans"; layout left; text-color #201240; title ${digits.length > 3 ? digits[3] : ""} }
	}
	item "digit 5" {
		auto-layout row; align center; justify center; width 60; height 78; clip yes; color #f3e5f5; border-color #00000017; corner-radius 12
		item _5 { font-size 32; line-height 42; font-family "IBM Plex Sans"; layout left; text-color #201240; title ${digits.length > 4 ? digits[4] : ""} }
	}
	item "digit 6" {
		auto-layout row; align center; justify center; width 60; height 78; clip yes; color #f3e5f5; border-color #00000017; corner-radius 12
		item _6 { font-size 32; line-height 42; font-family "IBM Plex Sans"; layout left; text-color #201240; title ${digits.length > 5 ? digits[5] : ""} }
	}
}
item LoginWorkspace {
	export let name = Workspace; export let note = "last visit 2 days ago"; export let width = 428; auto-layout column; padding 16; align center; clip yes
	color #6b3ad31a; border-color #00000017; corner-radius 16; width ${width}; pos 532 -2068
	item Workspace { font-size 14; line-height 18; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #201240; title ${name} }
	item "last visit 2 days ago" { font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #201240; title ${note} }
}
item LoginBackTitle {
	export let title = Title; export let width = 428; auto-layout row; gap 8; align center; height 44; clip yes; width ${width}; pos 1056 -2068
	item back {
		auto-layout row; align center; justify center; width 48; height 44; clip yes; corner-radius 8
		use Libraries.ui_kit.Icon.kit_ChevronLeftLarge as "icon/kit/ChevronLeftLarge" { color #201240 }
	}
	item Title { font-size 24; line-height 31; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #000061; title ${title} }
}
