	item Copyright {
		auto-layout row; gap 4; align center; clip yes; pos 28 -1045.5
		item "© 2026," { title "© 2026,"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #3c4149 }
		item "Intabia Fusion" { title "Intabia Fusion"; font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #333333 }
	}
	item "Card slot" {
		auto-layout row; align center; justify center; width 1920; height 1080
		slot Card_slot {
			use LoginCard as "Login card" {
				slot content {}
			}
		}
	}
	use Libraries.workbench.TopBar as "Top bar" {
		at limits { hidden yes }
		at icon_kit_Search { hidden yes }
		at icon_kit_Camera { hidden yes }
		at icon_recorder_dot { hidden yes }
		at icon_recorder_Rec { hidden yes }
		at tabs { hidden yes }
	}
}
item LoginCard {
	auto-layout column; padding 16 0 32 0; width 460; clip yes; color linear 225 #f0f0f0 0 #ffffff 1; corner-radius 16; shadow -30 -1.5 174 #121437ff; pos 24 -1240
	slot content
}
item LoginForm {
	auto-layout column; padding 32; width 460; clip yes; pos 580 -1240
	slot content
}
item LoginTabs {
	export let heading = Platform; export let width = 396; auto-layout column; align center; clip yes; width ${width}; pos 1136 -1240
	item heading {
		auto-layout row; align center; justify center; width 396; height 36; clip yes
		item Platform { font-size 28; line-height 36; font-family "IBM Plex Sans"; layout left; text-color #000061; title ${heading} }
	}
	item tabs {
		auto-layout row; gap 28; justify center; width 396; height 34; clip yes
		item "Tab/Sign up" {
			auto-layout column; gap 6; height 34; clip yes
			item "Sign up" { title "Sign up"; font-size 20; line-height 26; font-family "IBM Plex Sans"; font-weight 500; layout left; text-color #333333 }
			item underline { auto-layout abs; width fill; height 2; clip yes }
		}
		item "Tab/Log In" {
			auto-layout column; gap 6; height 34; clip yes
			item "Log In" { title "Log In"; font-size 20; line-height 26; font-family "IBM Plex Sans"; font-weight 600; layout left; text-color #333333 }
			item underline { auto-layout abs; width fill; height 2; clip yes; color #cf13a2 }
		}
	}
}
item LoginTitle {
	export let text = Title; export let subtitle = ""; auto-layout column; width 396; clip yes; pos 1628 -1240
	item Subtitle { font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #201240; title ${subtitle}; hidden ${subtitle === ""} }
	item Title { font-size 28; line-height 36; font-family "IBM Plex Sans"; font-weight 700; layout left; text-color #333333; title ${text} }
}
item LoginField {
	export let label = Label; export let value = Value; export let password = false; export let error = false; export let width = 396; auto-layout abs; height 52
	clip yes; color #f3e5f5; border-color #e5e7eb; corner-radius 12; width ${width}; use-style ${(error === "true") ? "error" : ""}; pos 24 -1426
	styles {
		error { border-color #ee7a7a }
	}
	item Label { font-size 12; line-height 16; font-family "IBM Plex Sans"; layout left; text-color #333333cc; pos 21 -9; title ${label} }
	item Value {
		font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color #201240; pos 21 -24; title ${(password === "true") ? "********" : value}
	}
}
item LoginStatus {
	export let text = Message; export let kind = info; auto-layout column; padding 16 0 0 0; width 396; clip yes; pos 516 -1426
	styles { kind one-of info error }
	item message {
		auto-layout row; gap 8; padding 12 16; width 396; clip yes; color #ffffff; corner-radius 8; border-color ${kind === "error" ? "#ee7a7a99" : "#e5e7eb"}
		item icon {
			auto-layout column; padding 2 0 0 0; width 16; height 18; clip yes
			use Libraries.ui_kit.Icon.kit_InfoCircle as "icon/kit/InfoCircle" { color ${kind === "error" ? "#ee7a7a" : "#201240"} }
		}
		item Message {
			font-size 12; line-height 18; font-family "IBM Plex Sans"; layout left; width 338; title ${text}; text-color ${kind === "error" ? "#ee7a7a" : "#201240"}
		}
	}
}
item LoginButton {
	export let label = Button; export let kind = primary; export let disabled = false; auto-layout row; gap 8; padding 0 24; align center; justify center
	width 396; height 56; clip yes; color #cf13a2; corner-radius 8; use-style ${(disabled === "true") ? "disabled" : kind}; pos 1008 -1426
	styles {
		kind one-of primary default provider
		primary { color #cf13a2; border-color none; text-color #ffffff }
		default { color #ffffff; border-color #e5e7eb; text-color #201240 }
		provider { color #07040f; border-color none; text-color #ffffff }
		disabled { color #f3eafb; border-color none; text-color #9ca3af }
	}
	use LoginIcon_google as "icon/google" { hidden ${kind !== "provider" || (disabled === "true")} }
	item Button { font-size 16; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; title ${label} }
}
