	auto-layout column; gap 16; padding 16 0 0 0; width 396; clip yes; pos 1756 -1426
	slot content {
		item row {
			auto-layout row; gap 16; width 396; height 56; clip yes
			use LoginButton as "Button Sign in with Google" {
				kind provider; width 190
				at Button { title "Sign in with Google" }
			}
			use LoginButton as "Button Sign in with GitHub" {
				kind provider; width 190
				replace icon_google {
					use LoginIcon_github as "icon/github"
				}
				at Button { title "Sign in with GitHub" }
			}
		}
	}
}
item LoginCheckbox {
	export let checked = true; export let label = Label; export let invalid = false; auto-layout row; gap 11; padding 0 0 0 4; width 396; clip yes; pos 24 -1614
	item "box holder" {
		auto-layout column; padding 3 0 0 0; width 18; height 24; clip yes
		item box {
			auto-layout row; align center; justify center; width 18; height 18; clip yes; line-width 2; corner-radius 3.2
			color ${(checked === "true") ? "#cf13a2" : "#ffffff"}; border-color ${(invalid === "true") ? "#ee7a7a" : (checked === "true") ? "#cf13a2" : "#00000066"}
			use Libraries.ui_kit.Icon.tick as "icon/tick" { width 12; height 12; border-color #ffffff; line-width 0.98; hidden ${!(checked === "true")} }
		}
	}
	item Label { font-size 15.2; line-height 20; font-family "IBM Plex Sans"; layout left; width 363; text-color #201240; title ${label} }
}
