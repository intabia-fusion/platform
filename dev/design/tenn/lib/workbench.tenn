item NavItem {
	export let label = Issues; export let count = ""; export let selected = false; auto-layout row; gap 8; padding 0 8 0 10; align center; width 255; height 32
	clip yes; corner-radius 6; use-style ${(selected === "true") ? "selected" : ""}; pos 712 -1204
	styles {
		selected { color #a5bdff26 }
	}
	use Libraries.ui_kit.Icon.kit_CheckSquare as "icon/kit/CheckSquare" { color ${(selected === "true") ? "#cf13a2" : "#0f121a"} }
	item Issues {
		font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; title ${label}; text-color ${(selected === "true") ? "#cf13a2" : "#0f121a"}
	}
	item grow { auto-layout abs; width fill; height 1; clip yes; hidden ${count === ""} }
	item _3 { font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #7b879e; title ${count}; hidden ${count === ""} }
}
