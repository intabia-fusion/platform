entry "../../../../PlatformDesign.tenn"
item "§ Input" {
	auto-layout abs; width 720; height 100; border-color #0000000f; corner-radius 8; pos 0 0
	item title { title Input; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ Checkbox" {
	auto-layout abs; width 114; height 86; border-color #0000000f; corner-radius 8; pos 780 0
	item title { title Checkbox; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ Toggle" {
	auto-layout abs; width 134; height 88; border-color #0000000f; corner-radius 8; pos 942 0
	item title { title Toggle; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ Radio" {
	auto-layout abs; width 114; height 86; border-color #0000000f; corner-radius 8; pos 1104 0
	item title { title Radio; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item "§ EditBox" {
	auto-layout abs; width 304; height 104; border-color #0000000f; corner-radius 8; pos 1266 0
	item title { title EditBox; font-size 13; line-height 16; font-family "IBM Plex Sans"; font-weight 600; layout left; pos 24 -14 }
}
item Input {
	export let label = Label; export let value = Value; export let placeholder = ""; export let layout = single; export let icon = false; export let menu = false
	export let error = false; export let size = medium; auto-layout column; gap 4
	clip yes; use-style ${layout} ${size} ${(error === "true") ? "error" : ""}; pos 24 -44
	styles {
		layout one-of single multiline
		size one-of narrow medium wide
		narrow { field { width 160 } }
		wide { field { width 420 } }
		error { field { border-color #e34748 } }
		multiline {
			field {
				height 64; padding 8 10; align start
				Value { width 220 }
			}
		}
	}
	item Label { font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000099; title ${label}; hidden ${label === ""} }
	item field {
		auto-layout row; gap 6; padding 0 10; align center; width 240; height 32; clip yes; color #1530720d; border-color #1530720d; corner-radius 6
		use Icon.kit_PersonCircle as "icon/kit/PersonCircle" { color #00000099; hidden ${!(icon === "true")} }
		item Value { font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; text-color ${(value === "") ? "#556178" : "#0f121a"}; title ${(value === "") ? placeholder : value} }
		item grow { auto-layout abs; width fill; height 1; clip yes; hidden ${!(menu === "true")} }
		use Icon.chevronD as "icon/chevronD" { width 14; height 14; border-color #00000099; line-width 1.14; hidden ${!(menu === "true")} }
	}
}
item "Input/variants" {
	auto-layout row; gap 16; align end; clip yes; pos 280 -44
	use Input as "Input/narrow" { size narrow; label ""; at field.Value { title APP } }
	use Input as "Input/error" { label ""; error true; at field.Value { title APP } }
	use Input as "Input/placeholder" { label ""; value ""; placeholder Name }
}
item Checkbox {
	export let checked = true; export let label = Label; auto-layout row; gap 8; align center; clip yes; pos 804 -44
	item box {
		auto-layout row; align center; justify center; width 16; height 16; clip yes; line-width 0; corner-radius 4
		color ${(checked === "true") ? "#cf13a2" : "none"}; border-color ${(checked === "true") ? "none" : "#00000017"}
		use Icon.tick as "icon/tick" { width 12; height 12; border-color #ffffff; line-width 0.98; hidden ${!(checked === "true")} }
	}
	item Label { font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; title ${label} }
}
item Toggle {
	export let on = true; export let label = Label; auto-layout row; gap 8; align center; clip yes; pos 966 -44
	item track {
		auto-layout row; padding 2; align center; width 36; height 20; clip yes; corner-radius 10; color ${(on === "true") ? "#cf13a2" : "#78788052"}
		justify ${(on === "true") ? "end" : "start"}
		item Ellipse { width 16; height 16; corner-radius 8; color #ffffff; shadow 0 -3 8 #00000026 }
	}
	item Label { font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; title ${label} }
}
item Radio {
	export let on = true; export let label = Label; export let hint = ""; auto-layout row; gap 8; clip yes; pos 1148 -44
	item dot {
		auto-layout row; align center; justify center; width 16; height 16; clip yes; corner-radius 8; border-color ${(on === "true") ? "#cf13a2" : "#00000017"}
		line-width ${(on === "true") ? 5 : 1}
	}
	item text {
		auto-layout column; gap 2; clip yes
		item Label { font-size 14; line-height 18; font-family "IBM Plex Sans"; layout left; title ${label} }
		item Hint { font-size 12; line-height 15; font-family "IBM Plex Sans"; layout left; text-color #00000066; title ${hint}; hidden ${hint === ""} }
	}
}
item EditBox {
	export let value = Value; export let kind = ghost-large; export let width = 256; auto-layout row; padding 0 8; align center; height 36; clip yes
	border-color #0000000f; corner-radius 6; width ${width}; use-style ${kind}; pos 1310 -44
	styles {
		kind one-of ghost-large large-style editbox
		ghost-large {
			height 36; padding 0 8; border-color #0000000f
			Value { font-size 16; font-weight 500 }
		}
		large-style {
			height 26; padding 0; border-color none
			Value { font-size 20; font-weight 400 }
		}
		editbox {
			height 19; padding 0; border-color none
			Value { font-size 14; font-weight 400 }
		}
	}
	item Value { font-size 16; line-height 21; font-family "IBM Plex Sans"; font-weight 500; layout left; title ${value} }
}
