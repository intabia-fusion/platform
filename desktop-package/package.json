{
  "name": "desktop",
  "version": "0.7.0",
  "main": "dist/main/electron.js",
  "author": "Intabia Fusion <platform@intabia.ru>",
  "template": "@hcengineering/default-package",
  "scripts": {
    "_phase:package": "rushx package",
    "package": "rm -rf ./dist && cp -r ../desktop/dist . && cp ../desktop/.env ./dist && echo 'done'",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false NODE_ENV=production VERSION=$(node ../common/scripts/show_tag.js) MODEL_VERSION=$(node ../common/scripts/show_version.js) electron-builder build -p onTag",
    "dist-local": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false NODE_ENV=production VERSION=$(node ../common/scripts/show_tag.js) MODEL_VERSION=$(node ../common/scripts/show_version.js) electron-builder build",
    "dist-signed": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=true NODE_ENV=production VERSION=$(node ../common/scripts/show_tag.js) MODEL_VERSION=$(node ../common/scripts/show_version.js) electron-builder build -c.afterSign=scripts/notarize.js -p onTag",
    "dist-mac-win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false NODE_ENV=production VERSION=$(node ../common/scripts/show_tag.js) MODEL_VERSION=$(node ../common/scripts/show_version.js) electron-builder build --windows --x64",
    "format": "echo done",
    "bump": "bump-package-version",
    "bundle:server": "node ../common/scripts/esbuild.js --entry=src/server.ts --keep-names=true --sourcemap=external --minify",
    "dist-docker-build": "rushx bundle:server && ../common/scripts/docker_build.sh intabiafusion/desktop-distro",
    "dist-docker-push": "rushx bundle:server && rushx docker:build && ../common/scripts/docker_tag.sh intabiafusion/desktop-distro"
  },
  "devDependencies": {
    "@hcengineering/platform-rig": "workspace:^0.7.19",
    "@hcengineering/desktop": "workspace:^0.7.208",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "node-loader": "~2.0.0",
    "cross-env": "~7.0.3",
    "typescript": "^5.9.3",
    "electron": "^40.0.0",
    "@types/node": "^22.18.1",
    "electron-builder": "^25.1.8",
    "@electron/notarize": "^2.3.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-n": "^15.4.0",
    "eslint": "^8.54.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint-config-standard-with-typescript": "^40.0.0",
    "esbuild": "^0.25.10"
  },
  "dependencies": {
    "electron-squirrel-startup": "~1.0.0",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0"
  },
  "homepage": "https://platform.intabia.ru",
  "productName": "Platform Desktop",
  "description": "Platform Desktop experience",
  "build": {
    "productName": "Platform",
    "appId": "intabia.Platform",
    "directories": {
      "output": "deploy"
    },
    "files": [
      "./dist/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "Platform-macos-${version}-${arch}.${ext}",
      "target": "default",
      "icon": "./src/AppIcon.icns",
      "hardenedRuntime": true,
      "entitlements": "./entitlements.mac.plist",
      "entitlementsInherit": "./entitlements.mac.plist",
      "notarize": false,
      "publish": {
        "provider": "generic",
        "url": "https://platform.intabia.ru/_dist",
        "channel": "latest"
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Platform-windows-${version}-${arch}.${ext}",
      "verifyUpdateCodeSignature": false,
      "icon": "./src/AppIcon.ico",
      "publish": {
        "provider": "generic",
        "url": "https://platform.intabia.ru/_dist",
        "channel": "latest"
      },
      "extraResources": [
        {
          "from": "./dist/ui/public/icons/",
          "to": "./icons/",
          "filter": [
            "**/*.ico"
          ]
        }
      ]
    },
    "nsis": {
      "include": "installer.nsh",
      "installerIcon": "./src/AppIcon.ico",
      "uninstallerIcon": "./src/AppIcon.ico"
    },
    "linux": {
      "artifactName": "Platform-linux-${version}-${arch}.${ext}",
      "target": [
        "AppImage",
        "zip"
      ],
      "icon": "./src/AppIcon.png",
      "category": "Utility",
      "publish": {
        "provider": "generic",
        "url": "https://platform.intabia.ru/_dist",
        "channel": "latest"
      }
    }
  },
  "keywords": [
    "electron",
    "typescript",
    "svelte"
  ]
}
