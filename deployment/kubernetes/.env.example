# Copy to deployment/kubernetes/.env (gitignored). Loaded by every stand script.
#
# dual   - sanity and dev run together, sized for a 12 GB Docker VM.
# single - one stand at a time: starting the second one is refused by the stand lock.
STAND_MODE=dual
# Docker VM memory, used by `pnpm -w stand:budget` to report headroom.
STAND_MEMORY_BUDGET=12Gi
# Set to 1 to install the sealed-secrets controller on k3d (plain secrets stay the default).
# SEALED_SECRETS=1
