# Pinned versions for local Kubernetes stands.
# Single source read by deployment/kubernetes/scripts/* and CI.
# Bump deliberately, then re-run `pnpm -w stand:base:up`.

# Cluster runtime
K3S_IMAGE_TAG=v1.36.4-k3s1   # k3s image for k3d (matches k3d v5.9 default)
HELM_MAJOR=4                 # supported helm major version

# platform-base components
STRIMZI_VERSION=1.3.0        # Kafka operator install manifest (GitHub release), supports k8s >= 1.32
KAFKA_VERSION=4.2.2          # Kafka CR spec.kafka.version (supported by pinned Strimzi; plan's prod 4.1.1 needs older Strimzi)
POSTGRES_IMAGE=postgres:18.1
ELASTIC_IMAGE=elasticsearch:8.19.1
ELASTIC_PLUGINS_IMAGE=intabiafusion/elastic-plugins:8.19.1-slim
REDIS_IMAGE=redis:8.0.2-alpine3.21
SILO_IMAGE=pgsty/silo:RELEASE.2026-09-16T00-00-00Z
MAILPIT_IMAGE=axllent/mailpit:v1.33.0

# kind runtime
TRAEFIK_CHART_VERSION=42.3.0 # traefik helm chart for kind (app v3.7.17)
