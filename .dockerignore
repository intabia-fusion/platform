# Build context for deployment/kubernetes/docker/dev-front.Dockerfile.
# Sources and package manifests only; native artifacts and VCS stay out.

.git
**/.git

# Installed dependencies and build outputs (native binaries must never
# get into the Linux image from the macOS host).
**/node_modules
**/dist
**/lib
**/*.tsbuildinfo

# Local environment and tooling state.
**/.env
**/.env.*
**/.rush
**/.validate
**/.tmp-shots
**/coverage
**/logs
**/.stand

# Big data dirs not needed for install or webpack dev compile.
dumps
dev/.livekit
dev/doc-import-tool/output
common/temp

# Test artifacts (Playwright traces, allure) are huge and not needed.
**/test-results
**/playwright-report
**/playwright-report.json
**/allure-results
